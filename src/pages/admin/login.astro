---
import '../../styles/admin.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Ingresar · Panel Yeska Essence</title>
  <link rel="icon" href="/img/logo-badge.png">
  <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/karla-latin.woff2" crossorigin>
</head>
<body>
  <main class="login">
    <div class="login-carta">
      <div class="login-arte" aria-hidden="true">
        <figure class="arco">
          <img src="/img/centro-de-mesa.jpg" alt="" width="900" height="1125">
        </figure>
        <blockquote>"Transformamos la luz en arte, y el aroma en recuerdos."</blockquote>
      </div>

      <div class="login-form-lado">
        <a class="side-brand" href="/">
          <img src="/img/logo-badge.png" alt="" width="44" height="44">
          <span><b>Yeska Essence</b><small>Panel de la tienda</small></span>
        </a>
        <div>
          <span class="eyebrow">Acceso privado</span>
          <h1>Hola de nuevo</h1>
          <p>Ingresa para editar el catálogo, los precios y las fotos del sitio.</p>
        </div>

        <form class="login-form" id="loginForm" novalidate>
          <div class="aviso-error" id="avisoError" role="alert" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.01"/></svg>
            <span id="avisoTexto"></span>
          </div>
          <div class="field">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" inputmode="email" autocomplete="username" required aria-describedby="email-error">
            <p class="msg-error" id="email-error" hidden></p>
          </div>
          <div class="field">
            <label for="password">Contraseña</label>
            <div class="clave">
              <input id="password" name="password" type="password" autocomplete="current-password" required aria-describedby="password-error">
              <button class="btn-icon" type="button" id="verClave" aria-label="Mostrar contraseña" aria-pressed="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <p class="msg-error" id="password-error" hidden></p>
          </div>
          <button class="btn btn-oro btn-block" type="submit" id="submitBtn">Ingresar</button>
        </form>

        <a class="volver-sitio" href="/">← Volver al sitio</a>
      </div>
    </div>
  </main>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { errorDeCampo } from '../../lib/admin.js';

    const form = document.getElementById('loginForm') as HTMLFormElement;
    const email = document.getElementById('email') as HTMLInputElement;
    const password = document.getElementById('password') as HTMLInputElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const aviso = document.getElementById('avisoError')!;
    const avisoTexto = document.getElementById('avisoTexto')!;
    const verClave = document.getElementById('verClave')!;

    // A dónde volver tras ingresar. Solo rutas internas del panel: nunca un
    // dominio externo (evita que un enlace malicioso use el login de trampolín).
    const pedido = new URLSearchParams(location.search).get('volver') ?? '';
    const destino = /^\/admin(\/[\w\-/]*)?(\?[\w=&%\-]*)?$/.test(pedido) && !pedido.startsWith('/admin/login') ? pedido : '/admin';

    supabase.auth.getSession().then(({ data }) => {
      if (data.session) location.replace(destino);
    });

    verClave.addEventListener('click', () => {
      const ver = password.type === 'password';
      password.type = ver ? 'text' : 'password';
      verClave.setAttribute('aria-pressed', String(ver));
      verClave.setAttribute('aria-label', ver ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });

    const mostrarAviso = (texto: string) => { avisoTexto.textContent = texto; aviso.hidden = !texto; };

    // Cada error de Supabase con su causa real: antes todo decía
    // "contraseña incorrecta", incluso sin internet.
    function explicar(error: { code?: string; status?: number; message: string; name?: string }) {
      if (error.code === 'invalid_credentials' || /invalid login credentials/i.test(error.message)) return 'Correo o contraseña incorrectos.';
      if (error.code === 'email_not_confirmed') return 'Ese correo todavía no está confirmado. Confírmalo desde Supabase (Authentication → Users).';
      if (error.status === 429 || /rate limit/i.test(error.message)) return 'Demasiados intentos seguidos. Espera un minuto y vuelve a intentarlo.';
      if (error.name === 'AuthRetryableFetchError' || /fetch|network/i.test(error.message)) return 'No hay conexión con el servidor. Revisa tu internet.';
      return `No se pudo ingresar: ${error.message}`;
    }

    email.addEventListener('blur', () => { if (email.value) validarEmail(); });
    const validarEmail = () => errorDeCampo(email,
      !email.value.trim() ? 'Escribe tu correo.' :
      !email.validity.valid ? 'Ese correo no parece válido (ej: nombre@gmail.com).' : '');
    const validarClave = () => errorDeCampo(password, password.value ? '' : 'Escribe tu contraseña.');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      mostrarAviso('');
      const okEmail = validarEmail();
      const okClave = validarClave();
      if (!okEmail || !okClave) { (okEmail ? password : email).focus(); return; }

      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      const { error } = await supabase.auth.signInWithPassword({ email: email.value.trim(), password: password.value });
      if (error) {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
        mostrarAviso(explicar(error));
        password.select();
        return;
      }
      location.replace(destino);
    });
  </script>
</body>
</html>
