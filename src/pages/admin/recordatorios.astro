---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Recordatorios" current="recordatorios">
  <div class="page-head">
    <div>
      <span class="eyebrow">Línea de eventos</span>
      <h1>Recordatorios</h1>
      <p>Cada recordatorio tiene sus opciones de precio (unidad y al mayor). Abre la flecha de una fila para editar la descripción y las opciones.</p>
    </div>
    <button class="btn btn-oro" id="btnNuevo" type="button" aria-expanded="false" aria-controls="panelAlta">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Nuevo recordatorio
    </button>
  </div>

  <section class="tarjeta tarjeta-pad panel-alta" id="panelAlta" aria-labelledby="altaTitulo" hidden>
    <div class="tarjeta-head"><h2 id="altaTitulo">Nuevo recordatorio</h2></div>
    <form class="form-alta" id="formAlta" novalidate>
      <div class="field c6">
        <label for="n-nombre">Nombre</label>
        <input id="n-nombre" maxlength="120" required placeholder="Ej: Rocío de Flores" aria-describedby="n-nombre-error">
        <p class="msg-error" id="n-nombre-error" hidden></p>
      </div>
      <div class="field c6">
        <label for="n-descripcion">Descripción</label>
        <textarea id="n-descripcion" maxlength="800" required placeholder="Materiales, empaque y qué incluye…" aria-describedby="n-descripcion-error"></textarea>
        <p class="msg-error" id="n-descripcion-error" hidden></p>
      </div>
      <div class="field c3">
        <label for="n-nota">Nota <span class="ayuda">(opcional)</span></label>
        <input id="n-nota" maxlength="200" placeholder="Ej: Acetato adicional: $4.000">
      </div>
      <div class="field c3">
        <span class="field-label" id="n-foto-label">Foto <span class="ayuda">(opcional)</span></span>
        <label class="zona-foto" id="zonaFoto" aria-labelledby="n-foto-label">
          <span class="marco-foto">
            <img alt="Vista previa">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-8 8"/></svg>
          </span>
          <span><span data-texto>Elegir o arrastrar foto</span><small>Se optimiza sola antes de subir</small></span>
          <input type="file" accept="image/*">
        </label>
      </div>
      <div class="form-alta-pie">
        <p>Después de crearlo se abre para que agregues sus opciones de precio.</p>
        <button class="btn btn-ghost" type="button" id="btnCancelar">Cancelar</button>
        <button class="btn btn-oro" type="submit" id="btnGuardar">Crear recordatorio</button>
      </div>
    </form>
  </section>

  <div class="filtros" role="search">
    <div class="buscador">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <label class="sr-only" for="buscar">Buscar recordatorio</label>
      <input class="control" id="buscar" type="search" placeholder="Buscar por nombre o descripción" autocomplete="off">
    </div>
    <label class="sr-only" for="filtroEstado">Mostrar</label>
    <select class="control" id="filtroEstado">
      <option value="">Todos</option>
      <option value="visibles">Solo visibles</option>
      <option value="ocultos">Solo ocultos</option>
      <option value="sin-foto">Sin foto</option>
      <option value="sin-precio">Sin opciones de precio</option>
    </select>
    <p class="conteo" id="conteo" aria-live="polite"></p>
  </div>

  <div class="tarjeta tabla-marco">
    <table class="tabla">
      <caption class="sr-only">Recordatorios para eventos</caption>
      <thead>
        <tr>
          <th scope="col" class="c-exp"><span class="sr-only">Detalle</span></th>
          <th scope="col" class="c-foto">Foto</th>
          <th scope="col">Recordatorio</th>
          <th scope="col">Nota</th>
          <th scope="col" class="c-visible">En el sitio</th>
          <th scope="col" class="c-acciones"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody id="tbody">
        <tr class="fila-estado"><td colspan="6"><div class="esqueleto"></div></td></tr>
        <tr class="fila-estado"><td colspan="6"><div class="esqueleto"></div></td></tr>
        <tr class="fila-estado"><td colspan="6"><div class="esqueleto"></div></td></tr>
      </tbody>
    </table>
  </div>

  <script>
    import { supabase, cop } from '../../lib/supabase.js';
    import {
      esc, toast, mensajeError, confirmar, actualizar, eliminar, insertar,
      subirFoto, borrarFoto, elegirArchivo, selectorDeFoto, editarEnLinea,
      texto, opcional, leerPrecio, errorDeCampo, destello,
    } from '../../lib/admin.js';

    type Opcion = { id: string; descripcion: string; precio_unidad: number; precio_mayor: number; orden: number };
    type Recordatorio = {
      id: string; nombre: string; descripcion: string; nota: string | null; imagen_url: string | null;
      activo: boolean; orden: number; recordatorio_opciones: Opcion[];
    };

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const tbody = $('tbody');
    const conteo = $('conteo');
    const buscar = $<HTMLInputElement>('buscar');
    const filtroEstado = $<HTMLSelectElement>('filtroEstado');

    let recordatorios: Recordatorio[] = [];
    const abiertos = new Set<string>();
    const porId = (id: string) => recordatorios.find((r) => r.id === id);

    const params = new URLSearchParams(location.search);
    buscar.value = params.get('buscar') ?? '';
    filtroEstado.value = params.get('estado') ?? '';

    const ICONO_FOTO = '<svg viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>';
    const ICONO_BORRAR = '<svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>';
    const ICONO_QUITAR = '<svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    const ICONO_FLECHA = '<svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>';

    // ------------------------------------------------------------ carga ---
    async function cargar() {
      const { data, error } = await supabase
        .from('recordatorios')
        .select('id, nombre, descripcion, nota, imagen_url, activo, orden, recordatorio_opciones(id, descripcion, precio_unidad, precio_mayor, orden)')
        .order('orden', { ascending: true });
      if (error) {
        tbody.innerHTML = `<tr class="fila-estado"><td colspan="6"><div class="vacio">
          <b>No se pudieron cargar los recordatorios</b><p>${esc(mensajeError(error))}</p>
          <button class="btn btn-line" type="button" id="reintentar">Reintentar</button></div></td></tr>`;
        $('reintentar').addEventListener('click', cargar);
        return;
      }
      recordatorios = ((data ?? []) as Recordatorio[]).map((r) => ({
        ...r,
        recordatorio_opciones: (r.recordatorio_opciones ?? []).slice().sort((a, b) => a.orden - b.orden),
      }));
      render();
      if (params.get('nuevo') === '1') abrirAlta(true);
    }

    // ------------------------------------------------------------ tabla ---
    function resumen(r: Recordatorio) {
      const ops = r.recordatorio_opciones;
      if (!ops.length) return 'Sin opciones de precio todavía';
      // Una opción a $0 es una opción aún sin llenar: no cuenta para el "desde".
      const precios = ops.flatMap((o) => [o.precio_unidad, o.precio_mayor]).filter((n) => n > 0);
      const sinPrecio = ops.filter((o) => !o.precio_unidad && !o.precio_mayor).length;
      const partes = [`${ops.length} ${ops.length === 1 ? 'opción' : 'opciones'}`];
      if (precios.length) partes.push(`desde ${cop(Math.min(...precios))}`);
      if (sinPrecio) partes.push(`${sinPrecio} sin precio`);
      return partes.join(' · ');
    }

    function visibles() {
      const q = buscar.value.trim().toLowerCase();
      const estado = filtroEstado.value;
      return recordatorios.filter((r) =>
        (estado !== 'visibles' || r.activo) &&
        (estado !== 'ocultos' || !r.activo) &&
        (estado !== 'sin-foto' || !r.imagen_url) &&
        (estado !== 'sin-precio' || !r.recordatorio_opciones.length) &&
        (!q || r.nombre.toLowerCase().includes(q) || r.descripcion.toLowerCase().includes(q))
      );
    }

    function opcionHTML(o: Opcion) {
      return `
      <div class="opcion" data-opcion="${esc(o.id)}">
        <input class="control desc" data-campo="descripcion" value="${esc(o.descripcion)}" maxlength="200" aria-label="Descripción de la opción" placeholder="Ej: Con tapa y caja decorativa">
        <input class="control precio" data-campo="precio_unidad" value="${esc(o.precio_unidad)}" inputmode="numeric" aria-label="Precio por unidad">
        <input class="control precio" data-campo="precio_mayor" value="${esc(o.precio_mayor)}" inputmode="numeric" aria-label="Precio al mayor">
        <button type="button" class="btn-icon peligro js-quitar" aria-label="Eliminar esta opción">${ICONO_QUITAR}</button>
      </div>`;
    }

    function filaHTML(r: Recordatorio) {
      const n = esc(r.nombre);
      const abierto = abiertos.has(r.id);
      const detalleId = `detalle-${esc(r.id)}`;
      return `
      <tr data-id="${esc(r.id)}" class="${r.activo ? '' : 'oculto'}">
        <td class="c-exp">
          <button type="button" class="btn-icon expandir js-expandir" aria-expanded="${abierto}" aria-controls="${detalleId}" aria-label="Descripción y precios de ${n}">${ICONO_FLECHA}</button>
        </td>
        <td class="c-foto">
          <button type="button" class="foto-btn js-foto ${r.imagen_url ? '' : 'sin-foto'}" aria-label="Cambiar la foto de ${n}">
            <img src="${esc(r.imagen_url || '/img/logo-badge.png')}" alt="" width="56" height="70" loading="lazy" decoding="async">
            <span class="foto-ico" aria-hidden="true">${ICONO_FOTO}</span>
          </button>
        </td>
        <td class="c-principal">
          <span class="editable e-nombre" data-campo="nombre" aria-label="Nombre"></span>
          <span class="resumen js-resumen">${esc(resumen(r))}</span>
        </td>
        <td data-label="Nota"><span class="editable e-nota" data-campo="nota" data-vacio="Añadir nota" aria-label="Nota de ${n}"></span></td>
        <td data-label="En el sitio">
          <label class="visible-ctrl">
            <span class="switch"><input type="checkbox" class="js-activo" ${r.activo ? 'checked' : ''}><span class="track"></span><span class="thumb"></span></span>
            <span class="estado">${r.activo ? 'Visible' : 'Oculto'}</span>
            <span class="sr-only"> en el sitio: ${n}</span>
          </label>
        </td>
        <td class="c-acciones">
          <button type="button" class="btn-icon peligro js-eliminar" aria-label="Eliminar ${n}">${ICONO_BORRAR}</button>
        </td>
      </tr>
      <tr class="fila-detalle" id="${detalleId}" data-detalle="${esc(r.id)}" ${abierto ? '' : 'hidden'}>
        <td colspan="6">
          <div class="detalle">
            <div>
              <h3>Descripción</h3>
              <span class="editable e-desc" data-campo="descripcion" data-multilinea aria-label="Descripción de ${n}"></span>
            </div>
            <div>
              <h3>Opciones de precio</h3>
              <div class="opciones">
                <div class="opciones-cab" aria-hidden="true"><span>Opción</span><span>Unidad</span><span>Al mayor</span><span></span></div>
                <div class="js-lista-opciones">${r.recordatorio_opciones.map(opcionHTML).join('') || '<p class="opciones-vacio">Aún no tiene opciones de precio. Agrega al menos una para que el sitio muestre cuánto cuesta.</p>'}</div>
              </div>
              <button type="button" class="btn btn-line btn-sm js-agregar" style="margin-top:12px">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Agregar opción de precio
              </button>
            </div>
          </div>
        </td>
      </tr>`;
    }

    function render() {
      const lista = visibles();
      conteo.textContent = lista.length === recordatorios.length
        ? `${recordatorios.length} recordatorios`
        : `${lista.length} de ${recordatorios.length} recordatorios`;

      if (!lista.length) {
        const hayFiltro = buscar.value || filtroEstado.value;
        tbody.innerHTML = `<tr class="fila-estado"><td colspan="6"><div class="vacio">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <b>${hayFiltro ? 'Nada coincide con esos filtros' : 'Aún no hay recordatorios'}</b>
          <p>${hayFiltro ? 'Prueba con otra palabra o quita los filtros.' : 'Crea el primero con el botón “Nuevo recordatorio”.'}</p>
          ${hayFiltro ? '<button class="btn btn-line" type="button" id="limpiar">Quitar filtros</button>' : ''}
        </div></td></tr>`;
        document.getElementById('limpiar')?.addEventListener('click', () => {
          buscar.value = ''; filtroEstado.value = '';
          sincronizarURL(); render();
        });
        return;
      }
      tbody.innerHTML = lista.map(filaHTML).join('');
      tbody.querySelectorAll<HTMLTableRowElement>('tr[data-id]').forEach(conectarFila);
    }

    function conectarFila(tr: HTMLTableRowElement) {
      const r = porId(tr.dataset.id!)!;
      const detalle = tbody.querySelector<HTMLTableRowElement>(`tr[data-detalle="${CSS.escape(r.id)}"]`)!;
      const resumenEl = tr.querySelector('.js-resumen')!;
      const refrescarResumen = () => { resumenEl.textContent = resumen(r); };
      const guardar = async (cambios: Partial<Recordatorio>) => {
        await actualizar('recordatorios', r.id, cambios);
        Object.assign(r, cambios);
      };

      editarEnLinea(tr.querySelector<HTMLElement>('[data-campo="nombre"]')!, {
        valor: r.nombre, leer: texto('El nombre', 120),
        guardar: (v: string) => guardar({ nombre: v }),
      });
      editarEnLinea(tr.querySelector<HTMLElement>('[data-campo="nota"]')!, {
        valor: r.nota, leer: opcional(200),
        guardar: (v: string | null) => guardar({ nota: v }),
      });
      editarEnLinea(detalle.querySelector<HTMLElement>('[data-campo="descripcion"]')!, {
        valor: r.descripcion, leer: texto('La descripción', 800),
        guardar: (v: string) => guardar({ descripcion: v }),
      });

      // Desplegar sin volver a pintar la tabla: no se pierde lo que se esté editando.
      const btnExp = tr.querySelector<HTMLButtonElement>('.js-expandir')!;
      btnExp.addEventListener('click', () => {
        const abrir = detalle.hidden;
        detalle.hidden = !abrir;
        btnExp.setAttribute('aria-expanded', String(abrir));
        if (abrir) abiertos.add(r.id); else abiertos.delete(r.id);
      });

      const chk = tr.querySelector<HTMLInputElement>('.js-activo')!;
      const estado = tr.querySelector('.estado')!;
      chk.addEventListener('change', async () => {
        const activo = chk.checked;
        chk.disabled = true;
        try {
          await guardar({ activo });
          tr.classList.toggle('oculto', !activo);
          estado.textContent = activo ? 'Visible' : 'Oculto';
          toast(activo ? `“${r.nombre}” ya se ve en el sitio` : `“${r.nombre}” quedó oculto del sitio`);
        } catch (err) {
          chk.checked = !activo;
          toast(mensajeError(err), 'error');
        } finally { chk.disabled = false; }
      });

      const btnFoto = tr.querySelector<HTMLButtonElement>('.js-foto')!;
      btnFoto.addEventListener('click', async () => {
        const archivo = await elegirArchivo();
        if (!archivo) return;
        btnFoto.setAttribute('aria-busy', 'true');
        const vieja = r.imagen_url;
        try {
          const url = await subirFoto('recordatorios', archivo);
          try { await guardar({ imagen_url: url }); }
          catch (err) { borrarFoto(url); throw err; }
          btnFoto.querySelector('img')!.src = url;
          btnFoto.classList.remove('sin-foto');
          toast('Foto actualizada');
          borrarFoto(vieja);
        } catch (err) {
          toast(mensajeError(err), 'error');
        } finally { btnFoto.removeAttribute('aria-busy'); }
      });

      tr.querySelector('.js-eliminar')!.addEventListener('click', async () => {
        const n = r.recordatorio_opciones.length;
        const ok = await confirmar({
          titulo: `¿Eliminar “${r.nombre}”?`,
          mensaje: `Se borra del sitio para siempre${n ? ` junto con sus ${n} ${n === 1 ? 'opción' : 'opciones'} de precio` : ''}. Si solo quieres dejar de mostrarlo, usa el interruptor “Visible”.`,
        });
        if (!ok) return;
        try {
          await eliminar('recordatorios', r.id);   // las opciones se borran en cascada
          recordatorios = recordatorios.filter((x) => x.id !== r.id);
          abiertos.delete(r.id);
          render();
          toast('Recordatorio eliminado');
          borrarFoto(r.imagen_url);
        } catch (err) { toast(mensajeError(err), 'error'); }
      });

      // ------------------------------------------------ opciones de precio ---
      const listaOps = detalle.querySelector<HTMLElement>('.js-lista-opciones')!;
      const conectarOpcion = (fila: HTMLElement) => {
        const o = r.recordatorio_opciones.find((x) => x.id === fila.dataset.opcion)!;
        fila.querySelectorAll<HTMLInputElement>('input[data-campo]').forEach((input) => {
          const campo = input.dataset.campo as 'descripcion' | 'precio_unidad' | 'precio_mayor';
          input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
            if (e.key === 'Escape') { input.value = String(o[campo]); input.blur(); }
          });
          input.addEventListener('change', async () => {
            let valor: string | number;
            try {
              valor = campo === 'descripcion' ? texto('La descripción de la opción', 200)(input.value.trim()) : leerPrecio(input.value);
            } catch (err) {
              input.value = String(o[campo]); destello(input, 'error'); toast((err as Error).message, 'error'); return;
            }
            if (valor === o[campo]) { input.value = String(valor); return; }
            input.disabled = true;
            try {
              await actualizar('recordatorio_opciones', o.id, { [campo]: valor });
              (o as Record<string, unknown>)[campo] = valor;
              input.value = String(valor);
              destello(input, 'ok');
              refrescarResumen();
            } catch (err) {
              input.value = String(o[campo]); destello(input, 'error'); toast(mensajeError(err), 'error');
            } finally { input.disabled = false; }
          });
        });
        fila.querySelector('.js-quitar')!.addEventListener('click', async () => {
          const ok = await confirmar({ titulo: '¿Eliminar esta opción de precio?', mensaje: `“${o.descripcion}” deja de aparecer en el sitio.` });
          if (!ok) return;
          try {
            await eliminar('recordatorio_opciones', o.id);
            r.recordatorio_opciones = r.recordatorio_opciones.filter((x) => x.id !== o.id);
            fila.remove();
            if (!r.recordatorio_opciones.length) listaOps.innerHTML = '<p class="opciones-vacio">Aún no tiene opciones de precio. Agrega al menos una para que el sitio muestre cuánto cuesta.</p>';
            refrescarResumen();
            toast('Opción eliminada');
          } catch (err) { toast(mensajeError(err), 'error'); }
        });
      };
      listaOps.querySelectorAll<HTMLElement>('.opcion').forEach(conectarOpcion);

      const btnAgregar = detalle.querySelector<HTMLButtonElement>('.js-agregar')!;
      btnAgregar.addEventListener('click', async () => {
        btnAgregar.disabled = true;
        btnAgregar.setAttribute('aria-busy', 'true');
        try {
          const nueva = await insertar('recordatorio_opciones', {
            recordatorio_id: r.id, descripcion: 'Nueva opción', precio_unidad: 0, precio_mayor: 0,
            orden: r.recordatorio_opciones.reduce((m, o) => Math.max(m, o.orden), -1) + 1,
          }) as Opcion;
          r.recordatorio_opciones.push(nueva);
          listaOps.querySelector('.opciones-vacio')?.remove();
          listaOps.insertAdjacentHTML('beforeend', opcionHTML(nueva));
          const fila = listaOps.lastElementChild as HTMLElement;
          conectarOpcion(fila);
          refrescarResumen();
          const desc = fila.querySelector<HTMLInputElement>('.desc')!;
          desc.focus(); desc.select();
          toast('Opción agregada: escribe su descripción y precios');
        } catch (err) {
          toast(mensajeError(err), 'error');
        } finally {
          btnAgregar.disabled = false;
          btnAgregar.removeAttribute('aria-busy');
        }
      });
    }

    // ---------------------------------------------------------- filtros ---
    function sincronizarURL() {
      const u = new URL(location.href);
      for (const [k, v] of [['buscar', buscar.value.trim()], ['estado', filtroEstado.value]]) {
        if (v) u.searchParams.set(k, v); else u.searchParams.delete(k);
      }
      u.searchParams.delete('nuevo');
      history.replaceState(null, '', u);
    }
    let espera: ReturnType<typeof setTimeout>;
    buscar.addEventListener('input', () => { clearTimeout(espera); espera = setTimeout(() => { sincronizarURL(); render(); }, 150); });
    filtroEstado.addEventListener('change', () => { sincronizarURL(); render(); });

    // ------------------------------------------------------ alta nueva ---
    const panel = $('panelAlta');
    const form = $<HTMLFormElement>('formAlta');
    const btnNuevo = $<HTMLButtonElement>('btnNuevo');
    const btnGuardar = $<HTMLButtonElement>('btnGuardar');
    const foto = selectorDeFoto($('zonaFoto'));
    const nNombre = $<HTMLInputElement>('n-nombre');
    const nDescripcion = $<HTMLTextAreaElement>('n-descripcion');
    const nNota = $<HTMLInputElement>('n-nota');

    function abrirAlta(abrir: boolean) {
      panel.hidden = !abrir;
      btnNuevo.setAttribute('aria-expanded', String(abrir));
      if (abrir) { panel.scrollIntoView({ behavior: 'smooth', block: 'start' }); nNombre.focus({ preventScroll: true }); }
      else {
        form.reset(); foto.limpiar();
        [nNombre, nDescripcion].forEach((i) => errorDeCampo(i, ''));
      }
    }
    btnNuevo.addEventListener('click', () => abrirAlta(panel.hidden));
    $('btnCancelar').addEventListener('click', () => { abrirAlta(false); btnNuevo.focus(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fallidos = ([
        [nNombre, nNombre.value.trim() ? '' : 'Escribe el nombre del recordatorio.'],
        [nDescripcion, nDescripcion.value.trim() ? '' : 'Escribe una descripción (se muestra en el sitio).'],
      ] as [HTMLInputElement | HTMLTextAreaElement, string][]).filter(([i, m]) => !errorDeCampo(i, m));
      if (fallidos.length) { fallidos[0][0].focus(); return; }

      btnGuardar.disabled = true;
      btnGuardar.setAttribute('aria-busy', 'true');
      let url: string | null = null;
      try {
        const archivo = foto.archivo();
        if (archivo) url = await subirFoto('recordatorios', archivo);
        const nuevo = await insertar('recordatorios', {
          nombre: nNombre.value.trim(),
          descripcion: nDescripcion.value.trim(),
          nota: nNota.value.trim() || null,
          imagen_url: url,
          orden: recordatorios.reduce((m, r) => Math.max(m, r.orden), -1) + 1,
          activo: true,
        }) as Recordatorio;
        nuevo.recordatorio_opciones = [];
        recordatorios.push(nuevo);
        abiertos.add(nuevo.id);   // se abre para agregarle las opciones de precio
        abrirAlta(false);
        buscar.value = ''; filtroEstado.value = '';
        sincronizarURL(); render();
        const fila = tbody.querySelector<HTMLElement>(`tr[data-id="${CSS.escape(nuevo.id)}"]`);
        fila?.classList.add('recien');
        fila?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        toast(`“${nuevo.nombre}” creado. Agrégale sus opciones de precio.`);
      } catch (err) {
        if (url) borrarFoto(url);
        toast(mensajeError(err), 'error');
      } finally {
        btnGuardar.disabled = false;
        btnGuardar.removeAttribute('aria-busy');
      }
    });

    await cargar();
  </script>
</AdminLayout>
