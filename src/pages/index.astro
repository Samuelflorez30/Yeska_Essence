<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalURL} />
  <title>{tituloSEO}</title>
  <meta name="description" content={descripcionSEO}>

  <!-- Open Graph (WhatsApp, Instagram, Facebook) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Yeska Essence">
  <meta property="og:locale" content="es_CO">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={tituloSEO}>
  <meta property="og:description" content={descripcionSEO}>
  <meta property="og:image" content={ogImageURL}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Yeska Essence — velas artesanales en cera de soja y yeso">

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={tituloSEO}>
  <meta name="twitter:description" content={descripcionSEO}>
  <meta name="twitter:image" content={ogImageURL}>

  <!-- Icono y color de marca en pestañas, marcadores y al agregar a inicio -->
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#C49A45">

  <!-- Fuentes propias (ver @font-face en site.css). Se precargan las dos caras
       del primer pintado; la italica y la script entran despues sin bloquear. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/karla-latin.woff2" crossorigin>
  {origenFotos && <link rel="preconnect" href={origenFotos} crossorigin />}
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Datos estructurados: ficha de negocio local para Google -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Store',
    name: 'Yeska Essence',
    description: descripcionSEO,
    image: ogImageURL.toString(),
    url: canonicalURL.toString(),
    telephone: '+573214034007',
    priceRange: '$$',
    address: { '@type': 'PostalAddress', addressCountry: 'CO' },
    sameAs: ['https://www.instagram.com/Yeska_Essence'],
  })} />

  <!-- Datos estructurados: el catálogo, para resultados enriquecidos de producto.
       Sin URL propia por pieza (todo vive en /#coleccion), así que las tres
       apuntan a la misma página — sigue siendo válido para Google. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: productos.map((x, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: x.n,
        description: x.mat,
        image: x.img,
        url: canonicalURL.toString(),
        offers: {
          '@type': 'Offer',
          price: x.precio,
          priceCurrency: 'COP',
          availability: 'https://schema.org/InStock',
          url: canonicalURL.toString(),
        },
      },
    })),
  })} />
</head>
<body>

<div class="preload" id="preload" aria-hidden="true">
  <div class="stage">
    <div class="ring">
      <svg viewBox="0 0 150 150"><defs><linearGradient id="goldstroke" x1="0" x2="1"><stop offset="0" stop-color="#8C6318"/><stop offset=".5" stop-color="#E9CF7A"/><stop offset="1" stop-color="#8C6318"/></linearGradient></defs><circle class="track" cx="75" cy="75" r="70"/><circle class="bar" cx="75" cy="75" r="70"/></svg>
      <img src="img/logo-badge.png" alt="">
    </div>
    <div class="word" id="preWord">Yeska Essence</div>
    <div class="tag">Iluminando momentos</div>
    <div class="line"></div>
  </div>
</div>

<!-- Atmósfera fija: viñeta en las esquinas y luz alta (§2.1). El polvo dorado
     vive aparte, en su propio canvas: necesita un z-index por encima de los
     fondos opacos de las secciones Lienzo, y .ambiente vive en -1 a propósito. -->
<div class="ambiente" aria-hidden="true"><i class="vineta"></i><i class="luz"></i></div>
<canvas id="embers" class="polvo-canvas" aria-hidden="true"></canvas>

<header class="nav" id="nav">
  <div class="wrap">
    <!-- Escritorio: dos enlaces a cada lado de la marca (grid 1fr auto 1fr) -->
    <nav class="nav-izq" aria-label="Secciones">
      <ul class="nav-links">
        <li><a href="#coleccion">Colección</a></li>
        <li><a href="#esencia">Nuestra Historia</a></li>
      </ul>
    </nav>
    <a class="brand" href="#top" aria-label="Yeska Essence, inicio">
      <span class="brand-word">Yeska</span>
      <img src="img/logo-badge.png" alt="" width="480" height="502">
      <span class="brand-word">Essence</span>
    </a>
    <div class="nav-right">
      <nav aria-label="Más secciones">
        <ul class="nav-links">
          <li><a href="#proceso">Proceso</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>
      <button class="menu-btn" id="menuBtn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"><i></i><i></i><i></i></button>
    </div>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menú" inert>
  <!-- Marca de agua decorativa: no recibe foco ni clics -->
  <Image class="menu-agua" src={recorte(13)} alt="" aria-hidden="true" widths={[320, 640, 960]} sizes="45vw" format="webp" quality={60} loading="lazy" decoding="async" />
  <nav aria-label="Navegación principal">
    <ol>
      <li><a href="#top" data-close>Inicio</a></li>
      <li><a href="#esencia" data-close>Nuestra Esencia</a></li>
      <li><a href="#coleccion" data-close>Colección</a></li>
      <li><a href="#recordatorios" data-close>Recordatorios</a></li>
      <li><a href="#proceso" data-close>Proceso</a></li>
      <li><a href="#contacto" data-close>Contacto</a></li>
    </ol>
  </nav>
  <div class="menu-pie">
    <a href="https://www.instagram.com/Yeska_Essence" target="_blank" rel="noopener" aria-label="Instagram de Yeska Essence">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href="https://wa.me/573214034007" target="_blank" rel="noopener" aria-label="WhatsApp 321 403 4007">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>
  </div>
</div>

<a class="wa-float" href="https://wa.me/573214034007?text=Hola%20Yeska%20Essence%2C%20quiero%20hacer%20un%20pedido" target="_blank" rel="noopener" aria-label="Pedir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
  <span class="lbl">Pedir por WhatsApp</span>
</a>

<main id="top">

  <!-- 2 · HERO MANIFIESTO (boceto 3) ---------------------------------- -->
  <section class="hero amb-inmersivo" aria-labelledby="hero-title">
    <!-- capa de fondo: piezas pequeñas, desenfocadas, parallax 0.3× -->
    <div class="campo" aria-hidden="true">
      {campoFondo.map((c) => (
        <div class="par" data-par="0.3" data-tier={c.tier} style={`--x:${pos(c.x)}; --y:${pos(c.y)}; --xm:${pos(c.xm ?? c.x)}; --ym:${pos(c.ym ?? c.y)}; --s:${c.s}`}>
          <Image class={`flota capa-fondo f${c.f}`} style={`--r:${c.r}deg; --sc:.7`} src={recorte(c.n)} alt="" width={anchoMax(c.s)} densities={[1, 2]} format="webp" quality={72} loading="eager" decoding="async" fetchpriority="low" />
        </div>
      ))}
    </div>

    <div class="wrap">
      <div class="titular">
        <h1 id="hero-title" class="display rise rise-2">Transformamos la luz en arte y el aroma <em class="gold">en recuerdos</em></h1>
        <p class="micro pie rise rise-3">Hecho a mano, con intención</p>
      </div>
    </div>

    <!-- capa de frente: el plano más cercano (sigue desenfocado), parallax 1.15× -->
    <div class="campo campo-frente" aria-hidden="true">
      {campoFrente.map((c) => (
        <div class="par" data-par="1.15" data-tier={c.tier} style={`--x:${pos(c.x)}; --y:${pos(c.y)}; --xm:${pos(c.xm ?? c.x)}; --ym:${pos(c.ym ?? c.y)}; --s:${c.s}`}>
          <Image class={`flota capa-frente f${c.f}`} style={`--r:${c.r}deg`} src={recorte(c.n)} alt="" width={anchoMax(c.s)} densities={[1, 2]} format="webp" quality={75} loading="eager" decoding="async" fetchpriority="low" />
        </div>
      ))}
    </div>
  </section>

  <!-- 3 · TICKER ------------------------------------------------------ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track" id="ticker">
      <span>Cera de soja 100 %</span><span>Yeso artesanal</span><span>Fragancias premium</span><span>Hecho en Colombia</span><span>Precio al mayor para eventos</span><span>Personalización total</span>
    </div>
  </div>

  <!-- 4 · NUESTRA ESENCIA (boceto 1) ---------------------------------- -->
  <section id="esencia" class="section esencia amb-inmersivo" aria-labelledby="esencia-title">
    <div class="wrap">
      <div class="grid">
        <div class="texto reveal">
          <span class="eyebrow">Nuestra esencia</span>
          <h2 id="esencia-title" class="display">Tres materiales, una pieza que <span class="gold">no se marchita</span></h2>
          <p class="lead">No solo fabricamos velas: creamos experiencias sensoriales que se quedan en la casa mucho después de que la llama se apaga.</p>
          <div class="pilares">
            <div class="pilar">
              <span class="n">01</span>
              <div><h3>Bases de yeso hechas a mano</h3><p>Recipientes, bandejas y jarrones elaborados artesanalmente. El yeso permite acabados pulidos, minimalistas y elegantes que quedan como joya decorativa permanente en el hogar.</p></div>
            </div>
            <div class="pilar">
              <span class="n">02</span>
              <div><h3>Cera de soja 100 % natural</h3><p>Sostenible, biodegradable y de combustión limpia. Su punto de fusión más bajo garantiza mayor duración y una liberación de fragancia más intensa y pura.</p></div>
            </div>
            <div class="pilar">
              <span class="n">03</span>
              <div><h3>Esculturas en cera</h3><p>Desde peonías y rosas en tonos pastel hasta cactus exóticos, cada figura se esculpe para imitar la belleza de la naturaleza.</p></div>
            </div>
            <div class="pilar">
              <span class="n">04</span>
              <div><h3>Fragancias exquisitas</h3><p>Aromas premium que evocan frescura, serenidad y elegancia, diseñados para perdurar y crear ambientes acogedores.</p></div>
            </div>
          </div>
        </div>
        <figure class="arco reveal">
          <img src="img/centro-de-mesa.jpg" width="900" height="1125" alt="Centro de mesa: vasija acanalada de yeso con flores en cera de soja y lazo rosa" loading="lazy" decoding="async">
          <span class="filete" aria-hidden="true"></span>
        </figure>
      </div>
    </div>
  </section>

  <!-- 5 · COLECCIÓN DESTACADA (boceto 2) ------------------------------ -->
  <section class="section destacada amb-inmersivo" aria-labelledby="destacada-title">
