<script is:inline define:vars={{ siteData }}>

  const WA = 'https://wa.me/573214034007?text=';
  const pedir = (name) => WA + encodeURIComponent(`Hola Yeska Essence, me interesa "${name}". ¿Me cuentan fragancias y disponibilidad?`);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Los textos vienen del panel admin: se escapan antes de pintarlos como HTML.
  // Sin esto, un nombre con comillas (Vela "Luna") rompía la tarjeta entera.
  const ESC = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ESC[c]);

  // ---------- preloader: letras, anillo, y disolver (nunca más de ~2.6 s) ----------
  (() => {
    const pre = document.getElementById('preload');
    const word = document.getElementById('preWord');
    const text = word.textContent; word.textContent = '';
    [...text].forEach((ch, i) => {
      const s = document.createElement('span');
      s.textContent = ch === ' ' ? ' ' : ch; s.style.animationDelay = (0.35 + i * 0.05) + 's';
      word.appendChild(s);
    });
    const start = performance.now();
    const cerrar = () => pre.classList.add('done');
    const finish = () => setTimeout(cerrar, Math.max(0, 1100 - (performance.now() - start)));
    if (document.readyState !== 'loading') finish();
    else document.addEventListener('DOMContentLoaded', finish, { once: true });
    setTimeout(cerrar, 1500);   // tope duro: el §4 pide máximo 1,5 s
  })();

  // ---------- foco atrapado en superficies modales ----------
  // Devuelve el foco al disparador al cerrar, y mantiene el Tab dentro.
  const FOCO = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';
  function atrapar(caja, e) {
    if (e.key !== 'Tab') return;
    const items = [...caja.querySelectorAll(FOCO)].filter((el) => el.offsetParent !== null);
    if (!items.length) return;
    const primero = items[0], ultimo = items[items.length - 1];
    if (e.shiftKey && document.activeElement === primero) { e.preventDefault(); ultimo.focus(); }
    else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primero.focus(); }
  }

  // ---------- menú ----------
  const menu = document.getElementById('menu');
  const menuBtn = document.getElementById('menuBtn');
  const setMenu = (open) => {
    menu.classList.toggle('open', open);
    menu.toggleAttribute('inert', !open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.classList.toggle('locked', open);
    if (open) { const a = menu.querySelector(FOCO); if (a) a.focus(); }
    else menuBtn.focus();
  };
  menuBtn.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
  menu.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  menu.addEventListener('keydown', (e) => { if (menu.classList.contains('open')) atrapar(menu, e); });

  const productos = siteData.productos;
  const lineName = { flores: 'Flores', botanica: 'Botánica', figuras: 'Figuras', recipientes: 'Recipientes' };
  const byId = Object.fromEntries(productos.map((x) => [x.id, x]));
  const priceNum = (p) => parseInt(p.replace(/[^\d]/g, ''), 10) || 0;

  let favs = new Set();
  try { favs = new Set(JSON.parse(localStorage.getItem('yeska-favs') || '[]')); } catch (e) {}
  const saveFavs = () => { try { localStorage.setItem('yeska-favs', JSON.stringify([...favs])); } catch (e) {} };

  const state = { filter: 'todas', query: '', sort: 'default' };
  const grid = document.getElementById('products');
  const countEl = document.getElementById('count');

  function cardHTML(x, i) {
    const fav = favs.has(x.id);
    return `
    <article class="card" data-line="${x.line}" data-id="${x.id}" style="animation-delay:${Math.min(i, 10) * 50}ms">
      <div class="photo">
        <img src="${esc(x.img)}" alt="${esc(x.n)}: ${esc(x.mat)}" width="400" height="500" loading="lazy" decoding="async">
        <button type="button" class="qv-trigger" data-id="${x.id}" aria-label="Ver detalle de ${esc(x.n)}"></button>
        <span class="tag" data-line="${x.line}">${lineName[x.line]}</span>
        <button type="button" class="fav-btn" data-id="${x.id}" aria-pressed="${fav}" aria-label="${fav ? 'Quitar de favoritos' : 'Guardar en favoritos'}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-10.2-9.1C.1 8.9 1 5.4 4.2 4.2 6.5 3.3 9 4 12 6.8 15 4 17.5 3.3 19.8 4.2c3.2 1.2 4.1 4.7 2.4 7.7C19.5 16.4 12 21 12 21Z"/></svg>
        </button>
      </div>
      <div class="info">
        <h3>${esc(x.n)}</h3>
        <div class="price">${x.p}${x.note ? `<small>${esc(x.note)}</small>` : ''}</div>
      </div>
    </article>`;
  }

  function render() {
    const q = state.query.trim().toLowerCase();
    let list = productos.filter((x) =>
      (state.filter === 'todas' || x.line === state.filter) &&
      (!q || x.n.toLowerCase().includes(q) || x.mat.toLowerCase().includes(q))
    );
    if (state.sort === 'asc') list = [...list].sort((a, b) => priceNum(a.p) - priceNum(b.p));
    if (state.sort === 'desc') list = [...list].sort((a, b) => priceNum(b.p) - priceNum(a.p));
    countEl.textContent = list.length === productos.length ? `${list.length} piezas` : `${list.length} de ${productos.length} piezas`;
    grid.innerHTML = list.length ? list.map(cardHTML).join('') : `
      <div class="empty">
        <p>No encontramos piezas con esos filtros.</p>
        <button type="button" class="btn btn-line" id="clearFilters">Quitar filtros</button>
      </div>`;
    const clear = document.getElementById('clearFilters');
    if (clear) clear.addEventListener('click', () => {
      state.filter = 'todas'; state.query = ''; setSort('default');
      document.getElementById('buscador').value = '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === 'todas')));
      render();
    });
  }

  const chips = document.querySelectorAll('.chip');
  chips.forEach((ch) => ch.addEventListener('click', () => {
    state.filter = ch.dataset.filter;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === ch)));
    render();
  }));

  // Los chips ya no se envuelven en dos filas: si no caben, la tira se
  // desplaza. El táctil ya sabe deslizar solo; esto le da lo mismo al mouse
  // (arrastrar para desplazar), que si no se queda sin forma de ver los que
  // no caben en pantalla.
  const filtros = document.querySelector('.filters');
  if (filtros) {
    // Un mouse (y sobre todo un trackpad) casi nunca queda perfectamente
    // quieto entre bajar y soltar el clic: con un umbral de solo 3px, ese
    // temblor normal ya contaba como "arrastre" y se comía el clic del
    // filtro. Ahora el arrastre (y el pointer-events:none de los chips) solo
    // se activa si de verdad se cruzan 6px — por debajo de eso es un clic.
    const UMBRAL = 6;
    let bajando = false, arrastrando = false, inicioX = 0, inicioScroll = 0;
    filtros.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      bajando = true; arrastrando = false;
      inicioX = e.clientX; inicioScroll = filtros.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!bajando) return;
      const dx = e.clientX - inicioX;
      if (!arrastrando && Math.abs(dx) > UMBRAL) { arrastrando = true; filtros.classList.add('arrastrando'); }
      if (arrastrando) filtros.scrollLeft = inicioScroll - dx;
    });
    window.addEventListener('pointerup', () => { bajando = false; });
    // Si hubo arrastre real, el click que sigue al soltar no debe filtrar nada.
    filtros.addEventListener('click', (e) => {
      if (arrastrando) { e.preventDefault(); e.stopPropagation(); }
      arrastrando = false; filtros.classList.remove('arrastrando');
    }, true);
  }
  let searchTimer;
  document.getElementById('buscador').addEventListener('input', (e) => {
    clearTimeout(searchTimer);
    const val = e.target.value;
    searchTimer = setTimeout(() => { state.query = val; render(); }, 150);
  });
  // Un solo botón-icono en vez de un <select>: un clic hace ciclar entre las
  // tres formas de orden. El estado sale por aria-label (para lectores de
  // pantalla) y por data-sort (para el anillo dorado que lo marca activo).
  const sortModes = [
    { key: 'default', label: 'Ordenar: sugerido' },
    { key: 'asc', label: 'Ordenar: precio de menor a mayor' },
    { key: 'desc', label: 'Ordenar: precio de mayor a menor' },
  ];
  const ordenBtn = document.getElementById('orden');
  const setSort = (key) => {
    state.sort = key;
    ordenBtn.dataset.sort = key;
    ordenBtn.setAttribute('aria-label', sortModes.find((m) => m.key === key).label);
  };
  ordenBtn.addEventListener('click', () => {
    const i = sortModes.findIndex((m) => m.key === state.sort);
    setSort(sortModes[(i + 1) % sortModes.length].key);
    render();
  });

  const favToggle = document.getElementById('favToggle');
  const favPanel = document.getElementById('favPanel');
  const favList = document.getElementById('favList');
  const favCount = document.getElementById('favCount');
  const favSend = document.getElementById('favSend');
  function renderFavs() {
    favCount.textContent = favs.size;
    favToggle.hidden = favs.size === 0;
    if (favs.size === 0) favPanel.hidden = true;
    favList.innerHTML = favs.size ? [...favs].map((id) => {
      const x = byId[id]; if (!x) return '';
      return `
      <div class="fav-row">
        <img src="${esc(x.img)}" alt="" width="46" height="46" loading="lazy">
        <div><div class="fr-name">${esc(x.n)}</div><div class="fr-price">${x.p}</div></div>
        <button type="button" data-id="${x.id}" aria-label="Quitar ${esc(x.n)}">✕</button>
      </div>`;
    }).join('') : `<div class="fav-empty">Aún no guardas piezas. Toca el corazón en una foto para añadirla aquí.</div>`;
    const items = [...favs].map((id) => byId[id]).filter(Boolean);
    const msg = items.length
      ? `Hola Yeska Essence, quiero cotizar estas piezas:\n${items.map((x) => `• ${x.n} (${x.p})`).join('\n')}`
      : 'Hola Yeska Essence, quiero hacer un pedido';
    favSend.href = WA + encodeURIComponent(msg);
  }
  function toggleFav(id) {
    if (favs.has(id)) favs.delete(id); else favs.add(id);
    saveFavs(); renderFavs(); render();
    favToggle.classList.remove('bump'); void favToggle.offsetWidth; favToggle.classList.add('bump');
  }
  const setFavPanel = (open) => {
    favPanel.hidden = !open;
    favToggle.setAttribute('aria-expanded', String(open));
    if (open) { const a = favPanel.querySelector(FOCO); if (a) a.focus(); }
    else if (!favToggle.hidden) favToggle.focus();
  };
  favToggle.addEventListener('click', () => setFavPanel(favPanel.hidden));
  document.getElementById('favClose').addEventListener('click', () => setFavPanel(false));
  favPanel.addEventListener('keydown', (e) => atrapar(favPanel, e));
  favList.addEventListener('click', (e) => { const btn = e.target.closest('button[data-id]'); if (btn) toggleFav(btn.dataset.id); });

  const qv = document.getElementById('quickview');
  const qvBody = document.getElementById('qvBody');
  function openQuickview(id) {
    const x = byId[id]; if (!x) return;
    qvBody.innerHTML = `
      <img src="${esc(x.img)}" alt="${esc(x.n)}: ${esc(x.mat)}" width="500" height="625">
      <div class="qv-info">
        <span class="tag" data-line="${x.line}">${lineName[x.line]}</span>
        <h3>${esc(x.n)}</h3>
        <p class="mat">${esc(x.mat)}</p>
        <div class="price">${x.p}${x.note ? `<small>${esc(x.note)}</small>` : ''}</div>
        <div class="ctas">
          <a class="btn btn-oro" href="${pedir(x.n)}" target="_blank" rel="noopener">Pedir por WhatsApp</a>
          <button type="button" class="btn btn-line qv-fav" data-id="${x.id}">${favs.has(x.id) ? 'Quitar de favoritos' : 'Guardar en favoritos'}</button>
        </div>
      </div>`;
    qv.showModal();
  }
  grid.addEventListener('click', (e) => {
    const favBtn = e.target.closest('.fav-btn');
    if (favBtn) { toggleFav(favBtn.dataset.id); return; }
    const trigger = e.target.closest('.qv-trigger');
    if (trigger) openQuickview(trigger.dataset.id);
  });
  qvBody.addEventListener('click', (e) => {
    const btn = e.target.closest('.qv-fav');
    if (btn) { toggleFav(btn.dataset.id); btn.textContent = favs.has(btn.dataset.id) ? 'Quitar de favoritos' : 'Guardar en favoritos'; }
  });
  document.getElementById('qvClose').addEventListener('click', () => qv.close());
  qv.addEventListener('click', (e) => { if (e.target === qv) qv.close(); });

  // Escape cierra la superficie abierta más superficial. El <dialog> ya lo
  // hace solo; aquí cubrimos el menú y el panel de favoritos.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menu.classList.contains('open')) { setMenu(false); return; }
    if (!favPanel.hidden) setFavPanel(false);
  });

  render();
  renderFavs();

  const recs = siteData.recs;
  document.getElementById('recs').innerHTML = recs.map((r) => `
    <article class="rec">
      <img src="${esc(r.img)}" alt="${esc(r.n)}" width="120" height="150" loading="lazy" decoding="async">
      <div>
        <h3 class="serif">${esc(r.n)}</h3>
        <p>${esc(r.d)}</p>
        <table>
          <thead><tr><th>Opción</th><th style="text-align:right">Unidad</th><th style="text-align:right">Al mayor</th></tr></thead>
          <tbody>${r.rows.map(([o, u, m]) => `<tr><td>${esc(o)}</td><td class="n">$${u}</td><td class="n m">$${m}</td></tr>`).join('')}</tbody>
        </table>
        ${r.note ? `<p class="note">${esc(r.note)}</p>` : ''}
      </div>
    </article>`).join('');

  const ticker = document.getElementById('ticker');
  ticker.innerHTML += ticker.innerHTML;

  // ---------- scroll: nav, botón de subir y parallax, todo en un rAF ----------
  const nav = document.getElementById('nav');
  const toTop = document.getElementById('toTop');
  const capas = [...document.querySelectorAll('.par')].map((el) => ({ el, v: parseFloat(el.dataset.par) || 1, base: 0 }));
  const parallaxOn = !reduce && window.matchMedia('(min-width: 768px)').matches;

  // Las medidas de layout se toman aquí, NUNCA dentro del listener de scroll.
  let vh = window.innerHeight;
  function medir() {
    vh = window.innerHeight;
    if (!parallaxOn) return;   // sin parallax no hay nada que medir: evita un reflujo forzado
    const y = window.scrollY;
    for (const c of capas) c.base = c.el.getBoundingClientRect().top + y;
  }

  let ticking = false, scrollY = 0;
  function pintar() {
    ticking = false;
    nav.classList.toggle('scrolled', scrollY > 80);   // el header no existe hasta aqui
    toTop.classList.toggle('show', scrollY > 600);
    if (!parallaxOn) return;
    for (const c of capas) {
      const d = (scrollY + vh / 2 - c.base) * (c.v - 1);
      c.el.style.transform = `translate3d(0, ${Math.max(-160, Math.min(160, d)).toFixed(1)}px, 0)`;
    }
  }
  function onScroll() {
    scrollY = window.scrollY;
    if (!ticking) { ticking = true; requestAnimationFrame(pintar); }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => { medir(); onScroll(); }, { passive: true });
  window.addEventListener('load', () => { medir(); onScroll(); });
  medir(); onScroll();
  toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));

  // ---------- revelado al entrar en viewport, escalonado entre hermanos ----------
  (() => {
    const items = [...document.querySelectorAll('.reveal')];
    if (!items.length) return;
    if (reduce || !('IntersectionObserver' in window)) { items.forEach((el) => el.classList.add('dentro')); return; }
    const porPadre = new Map();
    items.forEach((el) => {
      const i = porPadre.get(el.parentElement) || 0;
      porPadre.set(el.parentElement, i + 1);
      if (i) el.style.transitionDelay = Math.min(i, 5) * 70 + 'ms';
    });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('dentro');
        io.unobserve(e.target);
      }
    }, { threshold: 0.15 });
    items.forEach((el) => io.observe(el));
  })();

  // ---------- polvo dorado: fijo a la ventana, recorre toda la página ----------
  // Un único canvas de viewport completo (position:fixed en el CSS), no uno
  // por sección: más intenso mientras el hero llena la pantalla ("bienvenida"),
  // se atenúa en cuanto se hace scroll y queda como brillo apenas perceptible
  // el resto del recorrido. La cuenta de partículas activas y su brillo se
  // recalculan con el scroll; el resto de la reserva sigue su ciclo de vida
  // en silencio (sin dibujarse) para no "aparecer" de golpe al reactivarse.
  const canvas = document.getElementById('embers');
  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d');
    const dpr = Math.min(devicePixelRatio || 1, 2);
    let W, H, sparks = [];
    const resize = () => { const r = canvas.getBoundingClientRect(); W = canvas.width = Math.floor(r.width * dpr); H = canvas.height = Math.floor(r.height * dpr); };
    // Oro claro y oro hondo llevan el peso; blanco y plateado dan el chispazo
    // diamantado, sin caer en un confeti de colores.
    const paleta = () => {
      const r = Math.random();
      if (r < 0.55) return '233,207,122';  // oro claro
      if (r < 0.80) return '196,154,69';   // oro hondo
      if (r < 0.92) return '255,255,255';  // blanco brillante
      return '225,232,238';                // plateado frío
    };
    const make = () => ({
      x: Math.random() * W, y: H + 20, r: (0.9 + Math.random() * 2.2) * dpr,
      vy: (0.15 + Math.random() * 0.45) * dpr, vx: (Math.random() - 0.5) * 0.25 * dpr,
      a: 0, life: 0, max: 400 + Math.random() * 500,
      hue: paleta(),
    });
    resize(); window.addEventListener('resize', resize, { passive: true });
    const nMax = window.innerWidth < 768 ? 20 : 44; // el "empujón" de bienvenida del hero
    const nMin = window.innerWidth < 768 ? 9  : 20; // sutil, pero se tiene que notar
    for (let i = 0; i < nMax; i++) { const s = make(); s.y = Math.random() * H; s.life = Math.random() * s.max; sparks.push(s); }
    const heroH = document.querySelector('.hero')?.offsetHeight || 800;
    let mezcla = 1; // 1 = plena intensidad del hero, baja hacia 0 según se aleja el scroll
    const medirMezcla = () => {
      const t = Math.min(1, window.scrollY / heroH);
      mezcla = 1 - t * t * (3 - 2 * t); // smoothstep: la transición no se siente de golpe
    };
    medirMezcla();
    window.addEventListener('scroll', medirMezcla, { passive: true });
    const tick = () => {
      ctx.clearRect(0, 0, W, H);
      const activos = Math.round(nMin + (nMax - nMin) * mezcla);
      const brillo = 0.55 + 0.45 * mezcla; // nunca cae del todo: "sutil" no es "invisible"
      for (let i = 0; i < sparks.length; i++) {
        const s = sparks[i];
        s.life++; s.y -= s.vy; s.x += s.vx + Math.sin(s.life / 40) * 0.2 * dpr;
        const t = s.life / s.max; s.a = t < 0.2 ? t / 0.2 : (1 - t);
        if (s.life > s.max || s.y < -20) { Object.assign(s, make()); continue; }
        if (i >= activos) continue;
        const alpha = s.a * brillo * 0.85;
        // Destello: un halo suave (el "diamantado") con un núcleo brillante
        // encima — un círculo plano de 1-3px casi no se ve; el halo sí.
        const glowR = s.r * 3.4;
        const grad = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, glowR);
        grad.addColorStop(0, `rgba(${s.hue},${alpha.toFixed(3)})`);
        grad.addColorStop(.45, `rgba(${s.hue},${(alpha * .45).toFixed(3)})`);
        grad.addColorStop(1, `rgba(${s.hue},0)`);
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.arc(s.x, s.y, glowR, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${s.hue},${Math.min(1, alpha * 1.4).toFixed(3)})`; ctx.fill();
      }
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>
</body>
</html>
