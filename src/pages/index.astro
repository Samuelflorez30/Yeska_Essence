---
import { Image } from 'astro:assets';
import { supabase, cop, copPlain } from '../lib/supabase.js';
import { TEMAS, temaDeLinea } from '../lib/temas.js';
import '../styles/site.css';
import '../styles/tema-navidad.css';

// Recortes sin fondo (ya sin margen: ver scripts/recortar-flota.mjs).
// Pasan por <Image>, que los sirve en WebP a 1x y 2x del tamaño en pantalla.
const recortes = import.meta.glob<ImageMetadata>('../assets/flota/*.png', { eager: true, import: 'default' });
const recorte = (n: number) => recortes[`../assets/flota/${n}.png`];

// Las líneas (Flores, Navidad…) las administra el panel: aquí no hay ninguna
// fija. '*' en vez de nombrar columnas: si la base de datos aún no tiene
// `tema`/`activo` (supabase-migracion-lineas.sql), la consulta no falla.
const [{ data: lineasRaw, error: lineasError }, { data: productosRaw, error: productosError }] = await Promise.all([
  supabase.from('lineas').select('*').order('orden', { ascending: true }),
  supabase
    .from('productos')
    .select('id, nombre, materiales, precio, nota, imagen_url, orden, linea_id')
    .eq('activo', true)
    .order('orden', { ascending: true }),
]);

if (lineasError) console.error('[Supabase] lineas:', lineasError.message);
if (productosError) console.error('[Supabase] productos:', productosError.message);

type LineaDB = { id: string; slug: string; nombre: string; orden: number; tema?: string | null; activo?: boolean };
const lineaPorId = new Map(((lineasRaw ?? []) as LineaDB[]).map((l) => [l.id, l]));

// Una línea oculta (p. ej. Navidad en enero) se lleva sus productos con ella.
const productos = (productosRaw ?? []).flatMap((p) => {
  const linea = lineaPorId.get(p.linea_id);
  if (linea?.activo === false) return [];
  return [{
    id: p.id,
    n: p.nombre,
    line: linea?.slug ?? '',
    mat: p.materiales,
    p: cop(p.precio),
    precio: p.precio,
    note: p.nota || undefined,
    img: p.imagen_url || '/img/logo-badge.png',
  }];
});

// Un botón de filtro por línea visible que tenga al menos una pieza: un
// filtro que lleva a una grilla vacía no le sirve a nadie.
const lineas = [...lineaPorId.values()]
  .filter((l) => l.activo !== false && productos.some((p) => p.line === l.slug))
  .map((l) => ({ slug: l.slug, nombre: l.nombre, tema: temaDeLinea(l) as keyof typeof TEMAS | null }));const lineName: Record<string, string> = Object.fromEntries(lineas.map((l) => [l.slug, l.nombre]));
const temaDe: Record<string, string | null> = Object.fromEntries(lineas.map((l) => [l.slug, l.tema]));
// Ambientaciones que de verdad hay que dibujar (sin línea navideña, cero decorado en el HTML).
const temasUsados = [...new Set(lineas.map((l) => l.tema).filter((t): t is keyof typeof TEMAS => !!t))];
const hayNavidad = temasUsados.includes('navidad');

// /?linea=navidad abre la colección ya filtrada (y ambientada): es el enlace
// que el panel deja copiar para compartir en Instagram o WhatsApp.
const pedida = Astro.url.searchParams.get('linea');
const filtroInicial = pedida && lineName[pedida] ? pedida : 'todas';
const temaInicial = filtroInicial === 'todas' ? null : temaDe[filtroInicial];
const productosIniciales = filtroInicial === 'todas' ? productos : productos.filter((p) => p.line === filtroInicial);
const conteoInicial = productosIniciales.length === productos.length
  ? `${productos.length} piezas`
  : `${productosIniciales.length} de ${productos.length} piezas`;

// Cuenta regresiva de la ambientación navideña, en hora de Colombia. Solo en
// temporada (75 días antes); del 26 en adelante desaparece sola.
const cuentaNavidad = (() => {
  if (!hayNavidad) return null;
  const hoy = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Bogota', year: 'numeric', month: 'numeric', day: 'numeric' })
    .formatToParts(new Date()).map((x) => [x.type, Number(x.value)]));
  const dias = Math.round((Date.UTC(hoy.year, 11, 25) - Date.UTC(hoy.year, hoy.month - 1, hoy.day)) / 864e5);
  if (dias < 0 || dias > 75) return null;
  if (dias === 0) return '¡Feliz Navidad! Gracias por llenar tu casa de luz';
  if (dias === 1) return 'Mañana es Navidad';
  return `Faltan ${dias} días para Navidad · pide con tiempo`;
})();

const { data: recordatoriosRaw, error: recordatoriosError } = await supabase
  .from('recordatorios')
  .select('id, nombre, descripcion, nota, imagen_url, orden, recordatorio_opciones(descripcion, precio_unidad, precio_mayor, orden)')
  .eq('activo', true)
  .order('orden', { ascending: true });

if (recordatoriosError) console.error('[Supabase] recordatorios:', recordatoriosError.message);

const recs = (recordatoriosRaw ?? []).map((r) => ({
  id: r.id,
  n: r.nombre,
  d: r.descripcion,
  note: r.nota || undefined,
  img: r.imagen_url || '/img/logo-badge.png',
  rows: (r.recordatorio_opciones ?? [])
    .slice()
    .sort((a, b) => a.orden - b.orden)
    .map((o) => [o.descripcion, copPlain(o.precio_unidad), copPlain(o.precio_mayor)]),
}));

const siteData = { productos, recs, lineName, temaDe, filtroInicial };

// Tres piezas insignia para los pedestales de la Colección Destacada.
// Se eligen por nombre; si la dueña las renombra o desactiva en /admin,
// el hueco se rellena con las primeras del catálogo que tengan recorte.
// Las fotos se sirven desde Supabase Storage, otro origen: preconectar ahorra
// el DNS + TCP + TLS (unos 760 ms en 4G) antes de la primera imagen.
const origenFotos = (() => {
  try { return new URL(import.meta.env.PUBLIC_SUPABASE_URL).origin; } catch { return null; }
})();

// SEO: URLs absolutas a partir de `site` (astro.config.mjs). Con esto el
// canonical y las tarjetas de Open Graph/Twitter apuntan siempre al dominio
// real, incluso si el sitio se sirve un día desde un subdominio o preview.
// El `?? ` es solo por si el server de dev arrancó antes de fijar `site` en
// la config (no recarga ese valor en caliente); en build siempre llega bien.
const sitioBase = Astro.site ?? new URL('https://yeskaessence.com');
const canonicalURL = new URL(Astro.url.pathname, sitioBase);
const ogImageURL = new URL('/og-image.png', sitioBase);
const tituloSEO = 'Yeska Essence — Velas artesanales en cera de soja y yeso | Colombia';
const descripcionSEO = 'Velas artesanales hechas a mano en Colombia: figuras y arreglos en cera de soja y yeso, recordatorios para XV años, bodas y bautizos, y pedidos personalizados por WhatsApp.';
// Año del copyright del footer: se calcula en cada petición (SSR), no queda fijo.
const anio = new Date().getFullYear();

// Datos estructurados (JSON-LD). Se arman aquí y no dentro del <script> del
// <head>: una flecha `=>` dentro de la etiqueta confunde al resaltador del
// editor (toma su `>` como cierre de la etiqueta y pinta el resto en rojo).
// El `<` se escapa para que un nombre con "</script>" no pueda cerrar la etiqueta.
const jsonLD = (datos: object) => JSON.stringify(datos).replace(/</g, '\\u003c');

// Ficha de negocio local para Google.
const tiendaLD = jsonLD({
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: 'Yeska Essence',
  description: descripcionSEO,
  image: ogImageURL.toString(),
  url: canonicalURL.toString(),
  telephone: '+573214034007',
  email: 'holeripla@gmail.com',
  priceRange: '$$',
  address: { '@type': 'PostalAddress', addressCountry: 'CO' },
  sameAs: ['https://www.instagram.com/Yeska_Essence'],
});

// En los pedestales solo entran piezas con recorte sin fondo: una foto con
// mesa y pared detrás no puede levitar. Terraza Inmortal no tiene recorte,
// así que su lugar lo toma Esencia del Desierto (misma línea botánica).
const recortePorProducto: Record<string, number> = {
  'Esencia Acanalada': 1,
  'Abrazo Aromático': 2,
  'Set Armonía': 3,
  'Idilio Felino': 7,
  'Bouquet Colorido': 8,
  'Esencia del Desierto': 9,
  'Loto de Devoción': 10,
  'Nido de Oro': 13,
};
const conRecorte = productos
  .filter((p) => recortePorProducto[p.n])
  .map((p) => ({ ...p, recorte: recorte(recortePorProducto[p.n]) }));
const insignia = ['Abrazo Aromático', 'Bouquet Colorido', 'Esencia Acanalada'];
const destacados = insignia
  .map((n) => conRecorte.find((p) => p.n === n))
  .filter((p): p is (typeof conRecorte)[number] => p !== undefined);
for (const p of conRecorte) {
  if (destacados.length >= 3) break;
  if (!destacados.includes(p)) destacados.push(p);
}

// ===================== IMÁGENES DEL HERO (GRAVEDAD CERO) =====================
// Aquí se eligen las piezas que flotan en el hero. `n` es el número del PNG
// en src/assets/flota/ (1.png … 13.png): cambia ese número para cambiar la
// imagen. Borra una línea para quitar una pieza; muévela de lista para
// cambiarla de capa. Máximo 14 en total (presupuesto de rendimiento).
//   x / y   → posición en escritorio, en % del hero (0 = izquierda / arriba)
//   xm / ym → posición en móvil (si faltan, usa x / y)
//   s       → ancho: clamp(mínimo, según pantalla, máximo)
//   r       → inclinación en grados
//   f       → ritmo de levitación (1–14); no repitas números
//   sc      → escala extra opcional (solo frente). En móvil manda el .66 del CSS.
//   tier: 'b' → se oculta en móvil (en móvil quedan máximo 6 visibles)
// Todas las piezas van desenfocadas y por detrás del titular (site.css:
// .capa-fondo/.capa-frente, z-index 1 y 5 contra el 10 del texto): ninguna
// compite en nitidez ni en plano con la lectura — son atmósfera, no recorte.
// El titular mide como mucho 1000px y va centrado (site.css: .hero .titular),
// así que su borde real está a "50% ± 500px" del centro del hero, no a un %
// fijo del ancho: un x en % se acerca o se aleja del texto según el monitor
// sea angosto o ultra-wide. Las piezas que deben quedar en el margen, fuera
// de la columna de texto, usan calc() anclado a ese centro en vez de %; así
// se despegan del titular en vez de superponerse cuando la pantalla achica.
// `pos()` deja pasar ese calc() tal cual y solo añade "%" a los números.
const pos = (v: number | string) => (typeof v === 'number' ? `${v}%` : v);

// Fondo = pequeñas, desenfocadas, parallax 0.3×.
const campoFondo = [
  { n: 2,  x: 3,  y: 18,  s: 'clamp(84px, 11vw, 170px)',  r: -5, f: 1,  xm: 2,  ym: 1 },
  { n: 8,  x: 84, y: 24,  s: 'clamp(92px, 12vw, 190px)',  r: 6,  f: 3,  xm: 72, ym: 2 },
  { n: 6,  x: 68, y: 3,  s: 'clamp(56px, 6vw, 96px)',   r: 8,  f: 5,  xm: 56, ym: 6 },
  { n: 4,  x: 2,  y: 44, s: 'clamp(64px, 7vw, 110px)',  r: 5,  f: 12, tier: 'b' },
  { n: 12, x: 30, y: 84, s: 'clamp(52px, 5.5vw, 90px)', r: 7,  f: 6,  tier: 'b' },
  { n: 11, x: 62, y: 86, s: 'clamp(56px, 6vw, 96px)',   r: -8, f: 13, tier: 'b' },
];
// Frente = el plano más cercano, algo menos desenfocado que el fondo (nunca
// nítido), parallax 1.15×.
const campoFrente = [
  { n: 3,  x: 5,  y: 74, s: 'clamp(100px, 15vw, 180px)', r: 3,  f: 4,  xm: -2, ym: 84 },
  // En móvil la esquina inferior derecha es de los botones flotantes
  // (WhatsApp y favoritos): esta pieza se corre al centro-derecha.
  { n: 10, x: 82, y: 88, s: 'clamp(48px, 5vw, 80px)',    r: 7,  f: 7, xm: 62, ym: 79 },
  // n1 y n5 flanquean el titular por fuera de su columna de 1000px (arriba-
  // izquierda y a la altura de "en recuerdos"). Si el hero es angosto y no
  // hay margen real, calc() las saca de pantalla en vez de amontonarlas
  // detrás del texto.
  { n: 5, x: 'calc(50% + 520px)', y: 55, s: 'clamp(70px, 8vw, 130px)', r: -6, f: 10, tier: 'b' },
];
// =============================================================================

// Ancho máximo en px de cada `s`: es el 1x que se le pide al optimizador.
// Si `s` no termina en "…px)", se pide 300px, que cubre cualquier pieza.
const anchoMax = (s: string) => parseInt(s.match(/(\d+)px\)$/)?.[1] ?? '300', 10);

// ===================== DECORADO NAVIDEÑO (styles/tema-navidad.css) =====================
// Se dibuja una sola vez en el servidor y solo si alguna línea visible tiene
// la ambientación: queda escondido hasta que el cliente elige esa línea.
type Pt = [number, number];
// Curva cuadrática: punto y ángulo de la tangente en t (0…1)
const qPunto = (a: Pt, c: Pt, b: Pt, t: number): Pt => [
  (1 - t) ** 2 * a[0] + 2 * (1 - t) * t * c[0] + t * t * b[0],
  (1 - t) ** 2 * a[1] + 2 * (1 - t) * t * c[1] + t * t * b[1],
];
const qAngulo = (a: Pt, c: Pt, b: Pt, t: number) => Math.atan2(
  2 * (1 - t) * (c[1] - a[1]) + 2 * t * (b[1] - c[1]),
  2 * (1 - t) * (c[0] - a[0]) + 2 * t * (b[0] - c[0]),
);
// Azar con semilla: el mismo pino en cada visita (y en servidor y en caché).
const azar = (s: number) => () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
const f1 = (n: number) => n.toFixed(1);

// Guirnalda: 6 caídas de cable dorado en 1440 de ancho, 4 focos por caída.
// El SVG usa "slice": en móvil recorta los lados en vez de aplastar los focos.
const guirnalda = (() => {
  const y = 6, caida = 48, tramos = 6, ancho = 1440 / tramos;
  const colores = ['oro', 'rojo', 'verde', 'blanco'];
  let cable = `M0 ${y}`;
  const focos: { x: string; y: string; giro: string; color: string; i: number; d: string }[] = [];
  for (let k = 0; k < tramos; k++) {
    const a: Pt = [k * ancho, y], c: Pt = [k * ancho + ancho / 2, y + 2 * caida], b: Pt = [(k + 1) * ancho, y];
    cable += ` Q${c[0]} ${c[1]} ${b[0]} ${b[1]}`;
    for (const t of [0.17, 0.39, 0.61, 0.83]) {
      const [px, py] = qPunto(a, c, b, t);
      const i = focos.length;
      focos.push({
        x: f1(px), y: f1(py),
        giro: f1(qAngulo(a, c, b, t) * 180 / Math.PI * 0.35),   // cuelgan casi rectos
        color: colores[i % colores.length], i,
        d: (((i * 7) % 11) / 11 * 2.6).toFixed(2),              // titileo desfasado
      });
    }
  }
  return { cable, focos, colores };
})();

// Rama de pino escarchada: tallos curvos con agujas a ambos lados que se
// acortan hacia la punta. Tres verdes + puntas de escarcha.
const ramaPino = (() => {
  const r = azar(11);
  const agujas = ['', '', ''];
  let escarcha = '', tallos = '';
  const ramas: [Pt, Pt, Pt, number][] = [
    [[0, 14], [112, 10], [262, 92], 23],     // principal, cae hacia la derecha
    [[96, 25], [130, 46], [150, 118], 15],   // brote que cuelga
    [[150, 41], [196, 38], [236, 20], 12],   // brote que sube
  ];
  for (const [a, c, b, largo] of ramas) {
    tallos += `M${a} Q${c} ${b}`;
    for (let t = 0.03; t <= 1.0001; t += 0.032) {
      const [x, y] = qPunto(a, c, b, t);
      const th = qAngulo(a, c, b, t);
      const L = largo * (1 - 0.5 * t) * (0.82 + r() * 0.32);
      for (const lado of [-1, 1]) {
        const ang = th + lado * (0.82 + r() * 0.3);
        const x2 = x + Math.cos(ang) * L, y2 = y + Math.sin(ang) * L;
        agujas[Math.floor(r() * 3)] += `M${f1(x)} ${f1(y)}L${f1(x2)} ${f1(y2)}`;
        if (r() < 0.24) escarcha += `M${f1(x + Math.cos(ang) * L * 0.7)} ${f1(y + Math.sin(ang) * L * 0.7)}L${f1(x2)} ${f1(y2)}`;
      }
    }
  }
  return { agujas, escarcha, tallos };
})();

// Esferas que cuelgan del borde superior (a la derecha, donde no hay texto).
// x = distancia al borde derecho; largo = hilo en px; tier b = solo escritorio.
const coloresEsfera: Record<string, { luz: string; base: string; sombra: string; banda: string }> = {
  rojo:  { luz: '#F59AA0', base: '#B8323D', sombra: '#560E17', banda: '#E9CF7A' },
  oro:   { luz: '#FFF4CF', base: '#D2AC58', sombra: '#6E4A10', banda: '#8C6318' },
  verde: { luz: '#A3DBB2', base: '#2F7A4C', sombra: '#0F2E1D', banda: '#E9CF7A' },
  crema: { luz: '#FFFFFF', base: '#F1E3CF', sombra: '#A88D6B', banda: '#C49A45' },
};
const esferas = [
  { tipo: 'bola',     color: 'rojo',  x: '2.6%',  largo: 78,  tam: 46, mecer: 4.6 },
  { tipo: 'estrella', color: 'oro',   x: '9.4%',  largo: 30,  tam: 36, mecer: 5.5 },
  { tipo: 'gota',     color: 'verde', x: '14.6%', largo: 104, tam: 28, mecer: 6.2, tier: 'b' },
  { tipo: 'bola',     color: 'crema', x: '20.5%', largo: 52,  tam: 32, mecer: 5.1, tier: 'b' },
].map((e, i) => ({ ...e, i, svg: esferaSVG(e.tipo, coloresEsfera[e.color], `esf${i}`) }));

function esferaSVG(tipo: string, c: { luz: string; base: string; sombra: string; banda: string }, id: string) {
  const brillo = `<radialGradient id="${id}g" cx="34%" cy="38%" r="72%"><stop offset="0" stop-color="${c.luz}"/><stop offset=".5" stop-color="${c.base}"/><stop offset="1" stop-color="${c.sombra}"/></radialGradient>`;
  const metal = `<linearGradient id="${id}k" x1="0" x2="1"><stop offset="0" stop-color="#8C6318"/><stop offset=".5" stop-color="#F6E7B4"/><stop offset="1" stop-color="#8C6318"/></linearGradient>`;
  const casquillo = `<path d="M17.5 4a2.5 2.5 0 0 1 5 0" fill="none" stroke="#C49A45" stroke-width="1.4"/><rect x="14.5" y="4" width="11" height="7" rx="1.6" fill="url(#${id}k)"/>`;
  if (tipo === 'estrella') {
    const pts = Array.from({ length: 10 }, (_, k) => {
      const ang = -Math.PI / 2 + k * Math.PI / 5, rad = k % 2 ? 8.2 : 19;
      return `${f1(20 + Math.cos(ang) * rad)},${f1(25 + Math.sin(ang) * rad)}`;
    }).join(' ');
    return `<svg viewBox="0 0 40 46" aria-hidden="true" focusable="false"><defs>${metal}<linearGradient id="${id}e" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFF4CF"/><stop offset=".45" stop-color="#E2BE68"/><stop offset="1" stop-color="#8C6318"/></linearGradient></defs><path d="M17.5 2.5a2.5 2.5 0 0 1 5 0" fill="none" stroke="#C49A45" stroke-width="1.4"/><polygon points="${pts}" fill="url(#${id}e)" stroke="#F6E7B4" stroke-width=".8" stroke-linejoin="round"/><circle cx="16" cy="20" r="2.2" fill="#fff" opacity=".55"/></svg>`;
  }
  if (tipo === 'gota') {
    return `<svg viewBox="0 0 40 72" aria-hidden="true" focusable="false"><defs>${brillo}${metal}</defs>${casquillo}<path d="M20 11C31 19 35 31 30 43 27 51 22 57 20 70 18 57 13 51 10 43 5 31 9 19 20 11Z" fill="url(#${id}g)"/><path d="M8.5 33C14 37 26 37 31.5 33" fill="none" stroke="${c.banda}" stroke-width="1.8" opacity=".8"/><ellipse cx="14" cy="27" rx="2.6" ry="7" fill="#fff" opacity=".38" transform="rotate(18 14 27)"/></svg>`;
  }
  return `<svg viewBox="0 0 40 50" aria-hidden="true" focusable="false"><defs>${brillo}${metal}</defs>${casquillo}<circle cx="20" cy="30" r="18.5" fill="url(#${id}g)"/><path d="M2.4 27C10 32.5 30 32.5 37.6 27" fill="none" stroke="${c.banda}" stroke-width="2" opacity=".7"/><path d="M2.9 33.5C10 39 30 39 37.1 33.5" fill="none" stroke="${c.banda}" stroke-width="1.2" opacity=".55"/><ellipse cx="13" cy="22" rx="3.6" ry="6.4" fill="#fff" opacity=".42" transform="rotate(32 13 22)"/></svg>`;
}

// Estrellas que titilan dentro del arco que da paso a la colección (el arco
// se vuelve cielo nocturno). Coordenadas en % de la franja de transición.
const estrellasArco = [
  { x: 31, y: 72, s: 9, d: 0 }, { x: 42, y: 58, s: 6, d: 1.1 }, { x: 50, y: 80, s: 11, d: 2.2 },
  { x: 57, y: 63, s: 7, d: .6 }, { x: 68, y: 76, s: 8, d: 1.7 }, { x: 37, y: 88, s: 5, d: 2.8 },
  { x: 62, y: 90, s: 6, d: .3 }, { x: 24, y: 86, s: 6, d: 1.4 }, { x: 76, y: 88, s: 5, d: 2.5 },
];
// =============================================================================

// El catálogo, para resultados enriquecidos de producto. Sin URL propia por
// pieza (todo vive en /#coleccion), así que todas apuntan a la misma página:
// sigue siendo válido para Google.
const catalogoLD = jsonLD({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: productos.map((x, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: x.n,
      description: x.mat,
      image: x.img,
      url: canonicalURL.toString(),
      offers: {
        '@type': 'Offer',
        price: x.precio,
        priceCurrency: 'COP',
        availability: 'https://schema.org/InStock',
        url: canonicalURL.toString(),
      },
    },
  })),
});
---
<!doctype html>
<html lang="es" data-linea-tema={temaInicial ?? undefined}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalURL} />
  <title>{tituloSEO}</title>
  <meta name="description" content={descripcionSEO}>

  <!-- Open Graph (WhatsApp, Instagram, Facebook) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Yeska Essence">
  <meta property="og:locale" content="es_CO">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={tituloSEO}>
  <meta property="og:description" content={descripcionSEO}>
  <meta property="og:image" content={ogImageURL}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Yeska Essence — velas artesanales en cera de soja y yeso">

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={tituloSEO}>
  <meta name="twitter:description" content={descripcionSEO}>
  <meta name="twitter:image" content={ogImageURL}>

  <!-- Icono y color de marca en pestañas, marcadores y al agregar a inicio -->
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#C49A45">

  <!-- Fuentes propias (ver @font-face en site.css). Se precargan las dos caras
       del primer pintado; la italica y la script entran despues sin bloquear. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/karla-latin.woff2" crossorigin>
  {origenFotos && <link rel="preconnect" href={origenFotos} crossorigin />}
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Datos estructurados (JSON-LD): se arman en el frontmatter -->
  <script type="application/ld+json" set:html={tiendaLD} />
  <script type="application/ld+json" set:html={catalogoLD} />
</head>
<body>

<div class="preload" id="preload" aria-hidden="true">
  <div class="stage">
    <div class="ring">
      <svg viewBox="0 0 150 150"><defs><linearGradient id="goldstroke" x1="0" x2="1"><stop offset="0" stop-color="#8C6318"/><stop offset=".5" stop-color="#E9CF7A"/><stop offset="1" stop-color="#8C6318"/></linearGradient></defs><circle class="track" cx="75" cy="75" r="70"/><circle class="bar" cx="75" cy="75" r="70"/></svg>
      <img src="img/logo-badge.png" alt="">
    </div>
    <div class="word" id="preWord">Yeska Essence</div>
    <div class="tag">Iluminando momentos</div>
    <div class="line"></div>
  </div>
</div>

<!-- Atmósfera fija: viñeta en las esquinas y luz alta (§2.1). El polvo dorado
     vive aparte, en su propio canvas: necesita un z-index por encima de los
     fondos opacos de las secciones Lienzo, y .ambiente vive en -1 a propósito. -->
<div class="ambiente" aria-hidden="true"><i class="vineta"></i><i class="luz"></i></div>
<canvas id="embers" class="polvo-canvas" aria-hidden="true"></canvas>

<header class="nav" id="nav">
  <div class="wrap">
    <!-- Escritorio: dos enlaces a cada lado de la marca (grid 1fr auto 1fr) -->
    <nav class="nav-izq" aria-label="Secciones">
      <ul class="nav-links">
        <li><a href="#coleccion">Colección</a></li>
        <li><a href="#esencia">Nuestra Historia</a></li>
      </ul>
    </nav>
    <a class="brand" href="#top" aria-label="Yeska Essence, inicio">
      <span class="brand-word">Yeska</span>
      <img src="img/logo-badge.png" alt="" width="480" height="502">
      <span class="brand-word">Essence</span>
    </a>
    <div class="nav-right">
      <nav aria-label="Más secciones">
        <ul class="nav-links">
          <li><a href="#proceso">Proceso</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>
      <button class="menu-btn" id="menuBtn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"><i></i><i></i><i></i></button>
    </div>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menú" inert>
  <!-- Marca de agua decorativa: no recibe foco ni clics -->
  <Image class="menu-agua" src={recorte(13)} alt="" aria-hidden="true" widths={[320, 640, 960]} sizes="45vw" format="webp" quality={60} loading="lazy" decoding="async" />
  <nav aria-label="Navegación principal">
    <ol>
      <li><a href="#top" data-close>Inicio</a></li>
      <li><a href="#esencia" data-close>Nuestra Esencia</a></li>
      <li><a href="#coleccion" data-close>Colección</a></li>
      <li><a href="#recordatorios" data-close>Recordatorios</a></li>
      <li><a href="#proceso" data-close>Proceso</a></li>
      <li><a href="#contacto" data-close>Contacto</a></li>
    </ol>
  </nav>
  <div class="menu-pie">
    <a href="https://www.instagram.com/Yeska_Essence" target="_blank" rel="noopener" aria-label="Instagram de Yeska Essence">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href="https://wa.me/573214034007" target="_blank" rel="noopener" aria-label="WhatsApp 321 403 4007">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>
  </div>
</div>

<a class="wa-float" href="https://wa.me/573214034007?text=Hola%20Yeska%20Essence%2C%20quiero%20hacer%20un%20pedido" target="_blank" rel="noopener" aria-label="Pedir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
  <span class="lbl">Pedir por WhatsApp</span>
</a>

<main id="top">

  <!-- 2 · HERO MANIFIESTO (boceto 3) ---------------------------------- -->
  <section class="hero amb-inmersivo" aria-labelledby="hero-title">
    <!-- capa de fondo: piezas pequeñas, desenfocadas, parallax 0.3× -->
    <div class="campo" aria-hidden="true">
      {campoFondo.map((c) => (
        <div class="par" data-par="0.3" data-tier={c.tier} style={`--x:${pos(c.x)}; --y:${pos(c.y)}; --xm:${pos(c.xm ?? c.x)}; --ym:${pos(c.ym ?? c.y)}; --s:${c.s}`}>
          <Image class={`flota capa-fondo f${c.f}`} style={`--r:${c.r}deg; --sc:.7`} src={recorte(c.n)} alt="" width={anchoMax(c.s)} densities={[1, 2]} format="webp" quality={72} loading="eager" decoding="async" fetchpriority="low" />
        </div>
      ))}
    </div>

    <div class="wrap">
      <div class="titular">
        <h1 id="hero-title" class="display rise rise-2">Transformamos la luz en arte y el aroma <em class="gold">en recuerdos</em></h1>
        <p class="micro pie rise rise-3">Hecho a mano, con intención</p>
      </div>
    </div>

    <!-- capa de frente: el plano más cercano (sigue desenfocado), parallax 1.15× -->
    <div class="campo campo-frente" aria-hidden="true">
      {campoFrente.map((c) => (
        <div class="par" data-par="1.15" data-tier={c.tier} style={`--x:${pos(c.x)}; --y:${pos(c.y)}; --xm:${pos(c.xm ?? c.x)}; --ym:${pos(c.ym ?? c.y)}; --s:${c.s}`}>
          <Image class={`flota capa-frente f${c.f}`} style={`--r:${c.r}deg`} src={recorte(c.n)} alt="" width={anchoMax(c.s)} densities={[1, 2]} format="webp" quality={75} loading="eager" decoding="async" fetchpriority="low" />
        </div>
      ))}
    </div>
  </section>

  <!-- 3 · TICKER ------------------------------------------------------ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track" id="ticker">
      <span>Cera de soja 100 %</span><span>Yeso artesanal</span><span>Fragancias premium</span><span>Hecho en Colombia</span><span>Precio al mayor para eventos</span><span>Personalización total</span>
    </div>
  </div>

  <!-- 4 · NUESTRA ESENCIA (boceto 1) ---------------------------------- -->
  <section id="esencia" class="section esencia amb-inmersivo" aria-labelledby="esencia-title">
    <div class="wrap">
      <div class="grid">
        <div class="texto reveal">
          <span class="eyebrow">Nuestra esencia</span>
          <h2 id="esencia-title" class="display">Tres materiales, una pieza que <span class="gold">no se marchita</span></h2>
          <p class="lead">No solo fabricamos velas: creamos experiencias sensoriales que se quedan en la casa mucho después de que la llama se apaga.</p>
          <div class="pilares">
            <div class="pilar">
              <span class="n">01</span>
              <div><h3>Bases de yeso hechas a mano</h3><p>Recipientes, bandejas y jarrones elaborados artesanalmente. El yeso permite acabados pulidos, minimalistas y elegantes que quedan como joya decorativa permanente en el hogar.</p></div>
            </div>
            <div class="pilar">
              <span class="n">02</span>
              <div><h3>Cera de soja 100 % natural</h3><p>Sostenible, biodegradable y de combustión limpia. Su punto de fusión más bajo garantiza mayor duración y una liberación de fragancia más intensa y pura.</p></div>
            </div>
            <div class="pilar">
              <span class="n">03</span>
              <div><h3>Esculturas en cera</h3><p>Desde peonías y rosas en tonos pastel hasta cactus exóticos, cada figura se esculpe para imitar la belleza de la naturaleza.</p></div>
            </div>
            <div class="pilar">
              <span class="n">04</span>
              <div><h3>Fragancias exquisitas</h3><p>Aromas premium que evocan frescura, serenidad y elegancia, diseñados para perdurar y crear ambientes acogedores.</p></div>
            </div>
          </div>
        </div>
        <figure class="arco reveal">
          <img src="img/centro-de-mesa.jpg" width="900" height="1125" alt="Centro de mesa: vasija acanalada de yeso con flores en cera de soja y lazo rosa" loading="lazy" decoding="async">
          <span class="filete" aria-hidden="true"></span>
        </figure>
      </div>
    </div>
  </section>

  <!-- 5 · COLECCIÓN DESTACADA (boceto 2) ------------------------------ -->
  <section class="section destacada amb-inmersivo" aria-labelledby="destacada-title">
    <div class="wrap">
      <div class="marco-fino">
        <i class="petalo p1" aria-hidden="true"><svg viewBox="0 0 60 90"><path d="M30 0C46 20 50 46 30 90 10 46 14 20 30 0Z"/></svg></i>
        <i class="petalo p2" aria-hidden="true"><svg viewBox="0 0 60 90"><path d="M30 0C46 20 50 46 30 90 10 46 14 20 30 0Z"/></svg></i>
        <i class="petalo p3" aria-hidden="true"><svg viewBox="0 0 60 90"><path d="M30 0C46 20 50 46 30 90 10 46 14 20 30 0Z"/></svg></i>
        <i class="chispa c1" aria-hidden="true"></i>
        <i class="chispa c2" aria-hidden="true"></i>
        <div class="section-head head-centro reveal">
          <div>
            <span class="eyebrow">Colección destacada</span>
            <h2 id="destacada-title" class="display">Colección <span class="gold">Insignia</span></h2>
            <p class="lead">Tres piezas favoritas, curadas con pasión.</p>
          </div>
        </div>
        <div class="pedestales reveal">
          {destacados.map((p) => (
            <a class="pedestal" href={`#coleccion`} aria-label={`${p.n}, ${p.p} — ver en la colección`}>
              <span class="marco">
                <span class="marco-arco" aria-hidden="true"></span>
                <span class="pieza">
                  <Image src={p.recorte} alt={`${p.n}: ${p.mat}`} width={280} densities={[1, 2]} format="webp" quality={80} loading="lazy" decoding="async" />
                </span>
                <span class="sombra" aria-hidden="true"></span>
              </span>
              <span class="col">
                <b>{p.n}</b>
                <span class="precio-ped">{p.p}</span>
              </span>
            </a>
          ))}
        </div>
        <p class="pie"><a class="enlace-oro" href="#coleccion">Ver la colección completa →</a></p>
      </div>
    </div>
  </section>

  <!-- 6 · transición malva → nude ------------------------------------- -->
  <div class="transicion a-lienzo" aria-hidden="true">
    <svg class="arco-svg" viewBox="0 0 1440 160" preserveAspectRatio="none"><path d="M0 160V96C240 20 480 0 720 0s480 20 720 96v64Z" fill="#F3E8E6"/></svg>
    {hayNavidad && (
      <div class="tema-estrellas">
        {estrellasArco.map((s) => <i style={`--x:${s.x}%; --y:${s.y}%; --s:${s.s}px; --d:${s.d}s`}></i>)}
      </div>
    )}
  </div>

  <!-- 7 · LA COLECCIÓN (lienzo) --------------------------------------- -->
  <section id="coleccion" class="section amb-lienzo" aria-labelledby="coleccion-title">
    <!-- Escena navideña: noche de pino, nieve, luces y esferas. Va detrás del
         contenido (.wrap) e invisible hasta que html[data-linea-tema="navidad"]. -->
    {hayNavidad && (
      <div class="tema-escena" aria-hidden="true">
        <canvas class="tema-nieve" id="nieve"></canvas>
        <svg class="tema-rama izq" viewBox="-6 -16 286 150" focusable="false">
          <path class="tallo" d={ramaPino.tallos} />
          {ramaPino.agujas.map((d, k) => <path class={`aguja a${k}`} d={d} />)}
          <path class="escarcha" d={ramaPino.escarcha} />
          <g class="bayas"><circle cx="34" cy="30" r="5.6" /><circle cx="44.5" cy="25" r="5" /><circle cx="42" cy="37" r="4.6" /></g>
        </svg>
        <svg class="tema-rama der" viewBox="-6 -16 286 150" focusable="false">
          <path class="tallo" d={ramaPino.tallos} />
          {ramaPino.agujas.map((d, k) => <path class={`aguja a${k}`} d={d} />)}
          <path class="escarcha" d={ramaPino.escarcha} />
          <g class="bayas"><circle cx="34" cy="30" r="5.6" /><circle cx="44.5" cy="25" r="5" /><circle cx="42" cy="37" r="4.6" /></g>
        </svg>
        <svg class="tema-guirnalda" viewBox="0 0 1440 120" preserveAspectRatio="xMidYMin slice" focusable="false">
          <defs>
            {guirnalda.colores.map((c) => (
              <radialGradient id={`halo-${c}`}><stop offset="0" class={`halo-${c}`} stop-opacity=".9" /><stop offset="1" class={`halo-${c}`} stop-opacity="0" /></radialGradient>
            ))}
          </defs>
          <path class="cable" d={guirnalda.cable} />
          {guirnalda.focos.map((f) => (
            <g class={`foco f-${f.color}`} transform={`translate(${f.x} ${f.y}) rotate(${f.giro})`} style={`--i:${f.i}; --d:${f.d}s`}>
              <g class="luz"><circle class="halo" cy="14" r="17" fill={`url(#halo-${f.color})`} /></g>
              <rect class="casquillo" x="-3" y="-1" width="6" height="6.5" rx="1.2" />
              <path class="bombillo" d="M-3 5C-7 8.5-6.6 14-2.3 19.6Q0 22.6 2.3 19.6C6.6 14 7 8.5 3 5Z" />
              <ellipse class="reflejo" cx="-1.9" cy="11" rx="1.2" ry="2.8" />
            </g>
          ))}
        </svg>
        {esferas.map((e) => (
          <span class={`esfera esfera-${e.tipo}`} data-tier={e.tier} style={`--x:${e.x}; --largo:${e.largo}px; --tam:${e.tam}px; --i:${e.i}; --mecer:${e.mecer}s`}>
            <span class="esfera-cuerpo" set:html={e.svg} />
          </span>
        ))}
        <svg class="tema-ventisquero" viewBox="0 0 1440 110" preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="nieveFrente" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF" /><stop offset=".55" stop-color="#F3E8E6" /></linearGradient>
          </defs>
          <path class="atras" d="M0 110V58C90 34 170 30 260 48S420 70 520 44 700 14 820 36 1000 72 1120 50 1330 22 1440 40V110Z" />
          <path d="M0 110V72C120 52 220 60 330 70S520 82 640 62 840 40 960 58 1160 86 1280 70 1400 56 1440 60V110Z" fill="url(#nieveFrente)" />
        </svg>
      </div>
    )}
    <div class="wrap">
      <!-- Las cabeceras se apilan en la misma celda: cambiar de ambientación
           cruza los textos sin mover la barra de filtros de lugar. -->
      <div class="section-head cabecera-coleccion reveal">
        <div class="cab cab-base" data-cab="base" inert={temaInicial ? true : undefined} aria-hidden={temaInicial ? 'true' : undefined}>
          <span class="eyebrow">Catálogo</span>
          <h2 id="coleccion-title" class="display">La <span class="gold">colección</span></h2>
          <p>Cada pieza se hace por encargo con la fragancia y el color que elijas. Precios en pesos colombianos.</p>
        </div>
        {temasUsados.map((clave) => (
          <div class={`cab cab-${clave}`} data-cab={clave} inert={temaInicial !== clave ? true : undefined} aria-hidden={temaInicial !== clave ? 'true' : undefined}>
            <span class="eyebrow">{TEMAS[clave].eyebrow}</span>
            <h2 class="display">{TEMAS[clave].titulo} <span class="gold">{TEMAS[clave].destacado}</span></h2>
            <p>{TEMAS[clave].texto}</p>
          </div>
        ))}
      </div>
      <div class="toolbar reveal">
        <div class="filters-wrap">
          <div class="filters" role="group" aria-label="Filtrar por línea">
            <button type="button" class="chip" data-filter="todas" aria-pressed={filtroInicial === 'todas' ? 'true' : 'false'}>Todas</button>
            {lineas.map((l) => (
              <button type="button" class="chip" data-filter={l.slug} data-tema={l.tema ?? undefined} aria-pressed={filtroInicial === l.slug ? 'true' : 'false'}>{l.nombre}</button>
            ))}
          </div>
        </div>
        <div class="tools">
          <label class="search" for="buscador">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input id="buscador" type="search" placeholder="Buscar por nombre o material" autocomplete="off">
          </label>
          <button type="button" id="orden" class="sort-btn" data-sort="default" aria-label="Ordenar: sugerido">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6v13M8 19l-3-3M8 19l3-3M16 18V5M16 5l-3 3M16 5l3 3"/></svg>
          </button>
        </div>
      </div>
      <div class="conteo-fila">
        <p class="count" id="count" aria-live="polite">{conteoInicial}</p>
        {cuentaNavidad && (
          <p class="cuenta-navidad">
            <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12V2.5M9 5l3 3 3-3" /><path d="M12 12V2.5M9 5l3 3 3-3" transform="rotate(60 12 12)" /><path d="M12 12V2.5M9 5l3 3 3-3" transform="rotate(120 12 12)" /><path d="M12 12V2.5M9 5l3 3 3-3" transform="rotate(180 12 12)" /><path d="M12 12V2.5M9 5l3 3 3-3" transform="rotate(240 12 12)" /><path d="M12 12V2.5M9 5l3 3 3-3" transform="rotate(300 12 12)" /></g></svg>
            {cuentaNavidad}
          </p>
        )}
      </div>
      <!-- Renderizado en el servidor (antes solo lo pintaba el script del
           cliente): Google y cualquier cosa que no ejecute JS ahora sí ven
           el catálogo completo en el HTML. El script de más abajo sigue
           siendo el dueño de esta grilla — en cuanto carga, la vuelve a
           pintar él mismo (con favoritos, filtro y orden ya aplicados);
           esto es solo el primer pintado. -->
      <div class="products" id="products">
        {productosIniciales.map((x, i) => (
          <article class="card" data-line={x.line} data-id={x.id} style={`animation-delay:${Math.min(i, 10) * 50}ms`}>
            <div class="photo">
              <img src={x.img} alt={`${x.n}: ${x.mat}`} width="400" height="500" loading="lazy" decoding="async">
              <button type="button" class="qv-trigger" data-id={x.id} aria-label={`Ver detalle de ${x.n}`}></button>
              <span class="tag" data-line={x.line} data-tema={temaDe[x.line] ?? undefined}>{lineName[x.line]}</span>
              <button type="button" class="fav-btn" data-id={x.id} aria-pressed="false" aria-label="Guardar en favoritos">
