---
import { Image } from 'astro:assets';
import { supabase, cop, copPlain } from '../lib/supabase.js';
import '../styles/site.css';

// Recortes sin fondo (ya sin margen: ver scripts/recortar-flota.mjs).
// Pasan por <Image>, que los sirve en WebP a 1x y 2x del tamaño en pantalla.
const recortes = import.meta.glob<ImageMetadata>('../assets/flota/*.png', { eager: true, import: 'default' });
const recorte = (n: number) => recortes[`../assets/flota/${n}.png`];

const { data: productosRaw, error: productosError } = await supabase
  .from('productos')
  .select('id, nombre, materiales, precio, nota, imagen_url, orden, lineas(slug)')
  .eq('activo', true)
  .order('orden', { ascending: true });

if (productosError) console.error('[Supabase] productos:', productosError.message);

// Sin tipos generados, supabase-js supone que toda relación es un arreglo;
// productos → lineas es muchos-a-uno y llega como un solo objeto.
const productos = (productosRaw ?? []).map((p) => ({
  id: p.id,
  n: p.nombre,
  line: (p.lineas as unknown as { slug: string } | null)?.slug ?? 'recipientes',
  mat: p.materiales,
  p: cop(p.precio),
  precio: p.precio,
  note: p.nota || undefined,
  img: p.imagen_url || '/img/logo-badge.png',
}));
// Mismo mapa que usa el script del cliente (línea 640): se repite aquí, no
// se comparte, porque este archivo vive en dos mundos (frontmatter de
// servidor vs. <script> de navegador) que no importan variables entre sí.
const lineName: Record<string, string> = { flores: 'Flores', botanica: 'Botánica', figuras: 'Figuras', recipientes: 'Recipientes' };

const { data: recordatoriosRaw, error: recordatoriosError } = await supabase
  .from('recordatorios')
  .select('id, nombre, descripcion, nota, imagen_url, orden, recordatorio_opciones(descripcion, precio_unidad, precio_mayor, orden)')
  .eq('activo', true)
  .order('orden', { ascending: true });

if (recordatoriosError) console.error('[Supabase] recordatorios:', recordatoriosError.message);

const recs = (recordatoriosRaw ?? []).map((r) => ({
  id: r.id,
  n: r.nombre,
  d: r.descripcion,
  note: r.nota || undefined,
  img: r.imagen_url || '/img/logo-badge.png',
  rows: (r.recordatorio_opciones ?? [])
    .slice()
    .sort((a, b) => a.orden - b.orden)
    .map((o) => [o.descripcion, copPlain(o.precio_unidad), copPlain(o.precio_mayor)]),
}));

const siteData = { productos, recs };

// Tres piezas insignia para los pedestales de la Colección Destacada.
// Se eligen por nombre; si la dueña las renombra o desactiva en /admin,
// el hueco se rellena con las primeras del catálogo que tengan recorte.
// Las fotos se sirven desde Supabase Storage, otro origen: preconectar ahorra
// el DNS + TCP + TLS (unos 760 ms en 4G) antes de la primera imagen.
const origenFotos = (() => {
  try { return new URL(import.meta.env.PUBLIC_SUPABASE_URL).origin; } catch { return null; }
})();

// SEO: URLs absolutas a partir de `site` (astro.config.mjs). Con esto el
// canonical y las tarjetas de Open Graph/Twitter apuntan siempre al dominio
// real, incluso si el sitio se sirve un día desde un subdominio o preview.
// El `?? ` es solo por si el server de dev arrancó antes de fijar `site` en
// la config (no recarga ese valor en caliente); en build siempre llega bien.
const sitioBase = Astro.site ?? new URL('https://yeskaessence.com');
const canonicalURL = new URL(Astro.url.pathname, sitioBase);
const ogImageURL = new URL('/og-image.png', sitioBase);
const tituloSEO = 'Yeska Essence — Velas artesanales en cera de soja y yeso | Colombia';
const descripcionSEO = 'Velas artesanales hechas a mano en Colombia: figuras y arreglos en cera de soja y yeso, recordatorios para XV años, bodas y bautizos, y pedidos personalizados por WhatsApp.';

// En los pedestales solo entran piezas con recorte sin fondo: una foto con
// mesa y pared detrás no puede levitar. Terraza Inmortal no tiene recorte,
// así que su lugar lo toma Esencia del Desierto (misma línea botánica).
const recortePorProducto: Record<string, number> = {
  'Esencia Acanalada': 1,
  'Abrazo Aromático': 2,
  'Set Armonía': 3,
  'Idilio Felino': 7,
  'Bouquet Colorido': 8,
  'Esencia del Desierto': 9,
  'Loto de Devoción': 10,
  'Nido de Oro': 13,
};
const conRecorte = productos
  .filter((p) => recortePorProducto[p.n])
  .map((p) => ({ ...p, recorte: recorte(recortePorProducto[p.n]) }));
const insignia = ['Abrazo Aromático', 'Bouquet Colorido', 'Esencia Acanalada'];
const destacados = insignia
  .map((n) => conRecorte.find((p) => p.n === n))
  .filter((p): p is (typeof conRecorte)[number] => p !== undefined);
for (const p of conRecorte) {
  if (destacados.length >= 3) break;
  if (!destacados.includes(p)) destacados.push(p);
}

// ===================== IMÁGENES DEL HERO (GRAVEDAD CERO) =====================
// Aquí se eligen las piezas que flotan en el hero. `n` es el número del PNG
// en src/assets/flota/ (1.png … 13.png): cambia ese número para cambiar la
// imagen. Borra una línea para quitar una pieza; muévela de lista para
// cambiarla de capa. Máximo 14 en total (presupuesto de rendimiento).
//   x / y   → posición en escritorio, en % del hero (0 = izquierda / arriba)
//   xm / ym → posición en móvil (si faltan, usa x / y)
//   s       → ancho: clamp(mínimo, según pantalla, máximo)
//   r       → inclinación en grados
//   f       → ritmo de levitación (1–14); no repitas números
//   sc      → escala extra opcional (solo frente). En móvil manda el .66 del CSS.
//   tier: 'b' → se oculta en móvil (en móvil quedan máximo 6 visibles)
// Todas las piezas van desenfocadas y por detrás del titular (site.css:
// .capa-fondo/.capa-frente, z-index 1 y 5 contra el 10 del texto): ninguna
// compite en nitidez ni en plano con la lectura — son atmósfera, no recorte.
// El titular mide como mucho 1000px y va centrado (site.css: .hero .titular),
// así que su borde real está a "50% ± 500px" del centro del hero, no a un %
// fijo del ancho: un x en % se acerca o se aleja del texto según el monitor
// sea angosto o ultra-wide. Las piezas que deben quedar en el margen, fuera
// de la columna de texto, usan calc() anclado a ese centro en vez de %; así
// se despegan del titular en vez de superponerse cuando la pantalla achica.
// `pos()` deja pasar ese calc() tal cual y solo añade "%" a los números.
const pos = (v: number | string) => (typeof v === 'number' ? `${v}%` : v);

// Fondo = pequeñas, desenfocadas, parallax 0.3×.
const campoFondo = [
  { n: 2,  x: 3,  y: 18,  s: 'clamp(84px, 11vw, 170px)',  r: -5, f: 1,  xm: 2,  ym: 1 },
  { n: 8,  x: 84, y: 24,  s: 'clamp(92px, 12vw, 190px)',  r: 6,  f: 3,  xm: 72, ym: 2 },
  { n: 6,  x: 68, y: 3,  s: 'clamp(56px, 6vw, 96px)',   r: 8,  f: 5,  xm: 56, ym: 6 },
  { n: 4,  x: 2,  y: 44, s: 'clamp(64px, 7vw, 110px)',  r: 5,  f: 12, tier: 'b' },
  { n: 12, x: 30, y: 84, s: 'clamp(52px, 5.5vw, 90px)', r: 7,  f: 6,  tier: 'b' },
  { n: 11, x: 62, y: 86, s: 'clamp(56px, 6vw, 96px)',   r: -8, f: 13, tier: 'b' },
];
// Frente = el plano más cercano, algo menos desenfocado que el fondo (nunca
// nítido), parallax 1.15×.
const campoFrente = [
  { n: 3,  x: 5,  y: 74, s: 'clamp(100px, 15vw, 180px)', r: 3,  f: 4,  xm: -2, ym: 84 },
  // En móvil la esquina inferior derecha es de los botones flotantes
  // (WhatsApp y favoritos): esta pieza se corre al centro-derecha.
  { n: 10, x: 82, y: 88, s: 'clamp(48px, 5vw, 80px)',    r: 7,  f: 7, xm: 62, ym: 79 },
  // n1 y n5 flanquean el titular por fuera de su columna de 1000px (arriba-
  // izquierda y a la altura de "en recuerdos"). Si el hero es angosto y no
  // hay margen real, calc() las saca de pantalla en vez de amontonarlas
  // detrás del texto.
  { n: 5, x: 'calc(50% + 520px)', y: 55, s: 'clamp(70px, 8vw, 130px)', r: -6, f: 10, tier: 'b' },
];
// =============================================================================

// Ancho máximo en px de cada `s`: es el 1x que se le pide al optimizador.
// Si `s` no termina en "…px)", se pide 300px, que cubre cualquier pieza.
const anchoMax = (s: string) => parseInt(s.match(/(\d+)px\)$/)?.[1] ?? '300', 10);
